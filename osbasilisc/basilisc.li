#define BASILISC_VERSION "0.4"

// word types
#define WORD_NONE 0
#define WORD_VAR  1
#define WORD_NUM  2
#define WORD_STR  3
#define WORD_FSTR 4

#define WORD_FIRST_INST 5

#define WORD_INST_PRINT 5
#define WORD_INST_WRITE 6
#define WORD_INST_GOTO  7
#define WORD_INST_IF    8
#define WORD_INST_STOP  9
#define WORD_INST_LET   10
#define WORD_INST_LEN   11
#define WORD_INST_THEN  12
#define WORD_INST_LT    13
#define WORD_INST_ADD   14
#define WORD_INST_EQ    15
#define WORD_INST_MOD   16
#define WORD_INST_ED    17
#define WORD_INST_RUN   18
#define WORD_INST_NEW   19
#define WORD_INST_HELP  20
#define WORD_INST_SSTAT 21
#define WORD_INST_INC   22
#define WORD_INST_DEC   23
#define WORD_INST_MUL   24
#define WORD_INST_DIV   25
#define WORD_INST_SUB   26
#define WORD_INST_AND   27
#define WORD_INST_OR    28
#define WORD_INST_NEQ   29
#define WORD_INST_GT    30
#define WORD_INST_ELSE  31
#define WORD_INST_WHILE 32
#define WORD_INST_IN    33
#define WORD_INST_OUT   34
#define WORD_INST_RAND  35
#define WORD_INST_SRAND 36
#define WORD_INST_BSHL  37
#define WORD_INST_BSHR  38
#define WORD_INST_BAND  39
#define WORD_INST_BOR   40
#define WORD_INST_BXOR  41
#define WORD_INST_STR   42
#define WORD_INST_INT   43
#define WORD_INST_INPUT 44
#define WORD_INST_RMEM  45
#define WORD_INST_WMEM  46
#define WORD_INST_CLEAR 47
#define WORD_INST_DEBUG 48

#define VAARG           10 // max arguments in vafuncs

#define VAR_NONE        WORD_NONE
#define VAR_NUM         WORD_NUM
#define VAR_STR         WORD_STR

// execution return values
#define EXEC_END        0xFFFF
#define EXEC_ERROR      0xFFFE
#define EXEC_CONTINUE   0xFFFD

// memory layout
#define GOTO_TABLE      0x0100
#define VARTAB_DEBUT    0x0200
#define VARTAB_SIZE     0x1000
#define STRPROG_DEBUT   0x1200
#define STRPROG_SIZE    0x2000
#define MALLOC_DEBUT    0x3200
#define MALLOC_SIZE     0x1000
#define HEAP_DEBUT      0x4200

// library includes
#include "klib/screen.li"
#include "klib/input.li"
#include "klib/string.li"
#include "klib/malloc.li"
#include "klib/strdup.li"
#include "editor.li"

struct var_s {
    : [name]
    : type
    : value  // union { [str], num }
    : [prev] // var_s
}

struct word_s {
    : type
    : value // union { word [value], var_s [var_ptr], [str], num }
}

struct inst_s {
    : type
    : [name]
    : argc
    : ret_type
    : arg_types
}

vafunc say_error(argc, [argp]) {
    screen_color = 0x0900
    print("Error: ")
    _lNOVA(printf, argc, argp)
    screen_color = 0x0F00
}

$ [g_var_tail] = NULL // var_s
$ [[g_instructions]]
$ g_debug = 1

#define INSTRCTIONS_COUNT 44

#define WORD_NONE 0
#define WORD_VAR  1
#define WORD_NUM  2
#define WORD_STR  3
#define WORD_FSTR 4

#define WORD_ALL 0xF
#define FMT_ARG1(a1) (a1 << 12)
#define FMT_ARG2(a1, a2) (a1 << 12 |b a2 << 8)
#define FMT_ARG3(a1, a2, a3) (a1 << 12 |b a2 << 8 |b a3 << 4)
#define FMT_NOTP 0

g_instructions = array(
    WORD_INST_ADD,   "+",     2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_SUB,   "-",     2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_MUL,   "*",     2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_DIV,   "/",     2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_MOD,   "%",     2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_LT,    "<",     2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_GT,    ">",     2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_EQ,    "==",    2,     WORD_NUM,  FMT_ARG2(WORD_ALL, WORD_ALL),
    WORD_INST_NEQ,   "!=",    2,     WORD_NUM,  FMT_ARG2(WORD_ALL, WORD_ALL),
    WORD_INST_AND,   "AND",   2,     WORD_NUM,  FMT_ARG2(WORD_ALL, WORD_ALL),
    WORD_INST_OR,    "OR",    2,     WORD_NUM,  FMT_ARG2(WORD_ALL, WORD_ALL),
    WORD_INST_BSHL,  "<<",    2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_BSHR,  ">>",    2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_BAND,  "&",     2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_BOR,   "|",     2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_BXOR,  "^",     2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_STR,   "STR",   1,     WORD_STR,  FMT_ARG1(WORD_NUM),
    WORD_INST_INT,   "INT",   1,     WORD_NUM,  FMT_ARG1(WORD_STR),
    WORD_INST_LEN,   "LEN",   1,     WORD_NUM,  FMT_ARG1(WORD_STR),
    WORD_INST_LET,   "LET",   2,     WORD_NONE, FMT_ARG2(WORD_VAR, WORD_ALL),
    WORD_INST_INC,   "INC",   1,     WORD_NONE, FMT_ARG1(WORD_NUM),
    WORD_INST_DEC,   "DEC",   1,     WORD_NONE, FMT_ARG1(WORD_NUM),
    WORD_INST_GOTO,  "GOTO",  1,     WORD_NONE, FMT_ARG1(WORD_NUM),
    WORD_INST_IF,    "IF",    2,     WORD_NONE, FMT_ARG2(WORD_NUM, WORD_ALL),
    WORD_INST_THEN,  "THEN",  VAARG, WORD_NONE, FMT_NOTP,
    WORD_INST_ELSE,  "ELSE",  VAARG, WORD_NONE, FMT_NOTP,
    WORD_INST_WHILE, "WHILE", 2,     WORD_NONE, FMT_ARG2(WORD_NUM, WORD_ALL),
    WORD_INST_PRINT, "PRINT", VAARG, WORD_NONE, FMT_NOTP,
    WORD_INST_WRITE, "WRITE", VAARG, WORD_NONE, FMT_NOTP,
    WORD_INST_INPUT, "INPUT", 1,     WORD_STR,  FMT_ARG1(WORD_STR),
    WORD_INST_CLEAR, "CLEAR", 0,     WORD_NONE, FMT_NOTP,
    WORD_INST_RAND,  "RAND",  0,     WORD_NUM,  FMT_NOTP,
    WORD_INST_SRAND, "SRAND", 1,     WORD_NONE, FMT_ARG1(WORD_NUM),
    WORD_INST_IN,    "IN",    1,     WORD_NUM,  FMT_ARG1(WORD_NUM),
    WORD_INST_OUT,   "OUT",   2,     WORD_NONE, FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_RMEM,  "RMEM",  1,     WORD_NUM,  FMT_ARG1(WORD_NUM),
    WORD_INST_WMEM,  "WMEM",  2,     WORD_NONE, FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_STOP,  "STOP",  0,     WORD_NONE, FMT_NOTP,
    WORD_INST_ED,    "ED",    0,     WORD_NONE, FMT_NOTP,
    WORD_INST_RUN,   "RUN",   0,     WORD_NONE, FMT_NOTP,
    WORD_INST_NEW,   "NEW",   0,     WORD_NONE, FMT_NOTP,
    WORD_INST_HELP,  "HELP",  0,     WORD_NONE, FMT_NOTP,
    WORD_INST_SSTAT, "SSTAT", 0,     WORD_NONE, FMT_NOTP,
    WORD_INST_DEBUG, "DEBUG", 1,     WORD_NONE, FMT_ARG1(WORD_NUM)
)

func new_word(size) {
    $ addr = HEAP_DEBUT

    if (size == INTMAX) {
        addr = HEAP_DEBUT
        return NULL
    }

    : old = addr

    addr = addr + size

    return old
}

func new_var(size) {
    $ addr = VARTAB_DEBUT

    if (size == INTMAX) {
        addr = VARTAB_DEBUT
        return NULL
    }

    : old = addr

    addr = addr + size

    if (addr > VARTAB_DEBUT + VARTAB_SIZE) {
        say_error("out of memory\n")
        addr = old
        return NULL
    }
    return old
}

func is_in(c, str) {
    : i
    for i (0) {
        if ([str + i] == 0) {
            return 0
        }
        if ([str + i] == c) {
            return 1
        }
    }
}

func tok_end([str], length) {
    : in_quotes = 0
    : i = 0

    while (i < length && [str + i] && ([str + i] != ' ' || in_quotes) && [str + i] != '\n') {
        if ([str + i] == '"') {
            in_quotes = !in_quotes
        }
        if (in_quotes) {
            i++
            continue
        }

        if (is_in([str + i], "()+-*/%<>=!&|^")) {
            if (i) {
                return i
            }

            if (length == 1 || !is_in([str + i], "!=")) {
                return 1
            }

            i++

            return 1 + ([str + i] == '=')
        }

        i++
    }
    return i
}

func line_end([str], length) {
    : i = 0

    while (i < length && [str + i] && [str + i] != '\n') {
        i++
    }
    return i
}

func isnumber([str], length) {
    :i
    if (length == 0) {
        return 0
    }
    for i (0, length) {
        if ([str + i] < '0' || [str + i] > '9') {
            return 0
        }
    }
    return 1
}

func is_valid_var_name([str], length) {
    if (length == 0) {
        return 0
    }

    if (!(([str] >= 'a' && [str] <= 'z') || ([str] >= 'A' && [str] <= 'Z'))) {
        return 0
    }

    :i
    for i (1, length) {
        if (!(([str+i] >= 'a' && [str+i] <= 'z') || ([str+i] >= 'A' && [str+i] <= 'Z') || ([str+i] >= '0' && [str+i] <= '9') || [str+i] == '_')) {
            return 0
        }
    }

    return 1
}

func get_word_name(type) {
    :i
    switch (type) {
        case WORD_NONE {
            return "None"
        }
        case WORD_VAR {
            return "variable"
        }
        case WORD_NUM {
            return "number"
        }
        case WORD_STR {
            return "string"
        }
        case WORD_FSTR {
            return "fstring"
        }
    }

    for i (0, INSTRCTIONS_COUNT * sizeof(inst_s), sizeof(inst_s)) {
        if (inst_s[g_instructions + i].type == type) {
            return inst_s[g_instructions + i].name
        }
    }
    return "unknown"
}

func print_word([word]) { // word_s[word]
    :i

    if (word_s[word].type >= WORD_FIRST_INST) {
        printf("( ")
    }

    switch (word_s[word].type) {
        case WORD_NONE {
            printf("None ")
        }
        case WORD_VAR {
            printf("[%s] ", var_s[word_s[word].value].name)
        }
        case WORD_STR {
            printf("\"%s\" ", word_s[word].value)
        }
        case WORD_FSTR {
            printf("f\"%s\" ", word_s[word].value)
        }
        case WORD_NUM {
            printf("%d ", word_s[word].value)
        }
        default {
            printf("%s ", get_word_name(word_s[word].type))
        }
    }

    if (word_s[word].type < WORD_FIRST_INST) {
        return
    }

    i = 0
    while (word_s[word_s[word].value + i].type != WORD_NONE) {
        print_word(word_s[word].value + i)
        i = i + sizeof(word_s)
    }
    printf(") ")
}

func get_variable([str], length) {
    : [var] = g_var_tail

    while (var) {
        if (strneqcase(str, length, var_s[var].name)) {
            return var
        }
        var = var_s[var].prev
    }
    return NULL
}

func get_variable_or_create([str], length) {
    : [var] = get_variable(str, length)
    if (var) {
        return var
    }

    // variable not found, create a new one
    var = new_var(sizeof(var_s) + length + 1)
    var_s[var].name = var + sizeof(var_s)

    : i
    for i (0, length) {
        [var_s[var].name + i] = [str + i]
    }
    [var_s[var].name + length] = '\0'

    var_s[var].type = VAR_NONE
    var_s[var].value = 0
    var_s[var].prev = g_var_tail
    g_var_tail = var

    return var
}

func check_goto_label([str], [length], pos) {
    if ([length] == 0 || [str] != '[') {
        return 0
    }

    : i = 1
    while (i < [length] && [str+i] != ']') {
        i++
    }

    // found a label
    if (!isnumber(str + 1, i - 1)) {
        say_error("'%S' is not a valid label, expected a number\n", str, i + 1)
        return 0
    }

    : label_num = atoi(str + 1)
    if (label_num >= 100) {
        say_error("label '%d' is out of range (0-99)\n", label_num)
        return 0
    }

    [GOTO_TABLE + label_num] = pos // mark label as used
    [length] = [length] - (i + 1)

    return i + 1 // return the number of characters to skip
}

func find_matching_parenthesis([str], length) {
    : open_parens = 1
    : end = 0

    while (end < length && open_parens > 0) {
        if ([str + end] == '(') {
            open_parens++
        } elif ([str + end] == ')') {
            open_parens--
        }
        end++
    }
    if (open_parens != 0) {
        return 0
    }
    return end
}

func parse_str([str], length, [word]) { // word_s[word]
    while (length > 0 && ([str] == ' ')) {
        str++
        length--
    }

    // printf("parsing: %S\n", str, length)

    : end = tok_end(str, length)

    if (end == 0) {
        say_error("empty instruction\n")
        return NULL
    }

    : expected_args = 0
    : type = 0
    : i

    if (end > 1 && [str] == '"' && [str + end - 1] == '"') {
        if (word == NULL) {
            word = new_word(sizeof(word_s))
        }
        word_s[word].type = WORD_STR
        word_s[word].value = new_word(end - 1)
        str++
        for i (0, end - 2) {
            [word_s[word].value + i] = [str + i]
        }
        return word
    } elif (isnumber(str, end)) {
        if (word == NULL) {
            word = new_word(sizeof(word_s))
        }
        word_s[word].type = WORD_NUM
        word_s[word].value = atoi(str)
        return word
    }

    : [preloaded_word] = alloca(sizeof(word_s))
    word_s[preloaded_word].type = WORD_NONE

    for i (0, INSTRCTIONS_COUNT * sizeof(inst_s), sizeof(inst_s)) {
        if (strneqcase(str, end, inst_s[g_instructions + i].name)) {
            type = inst_s[g_instructions + i].type
            expected_args = inst_s[g_instructions + i].argc
            break
        }
    }

    if (type == 0) {
        : debut = end
        while (debut < length && [str + debut] == ' ') {
            debut++
        }
        if (debut < length && [str + debut] == '=') {
            if (!is_valid_var_name(str, end)) {
                say_error("invalid variable name: '%S'\n", str, end)
                return NULL
            }
            type = WORD_INST_LET
            expected_args = 2
            word_s[preloaded_word].type = WORD_VAR
            word_s[preloaded_word].value = get_variable_or_create(str, end)
            end = debut + 1 // skip '='
        } elif (get_variable(str, end) != NULL) {
            if (end < length) {
                say_error("'%S' is a variable, not an instruction\n", str, end)
                return NULL
            }
            if (word == NULL) {
                word = new_word(sizeof(word_s))
            }
            word_s[word].type = WORD_VAR
            word_s[word].value = get_variable(str, end)
            return word
        } else {
            say_error("'%S' is not a valid instruction\n", str, end)
            return NULL
        }
    }

    str = str + end
    length = length - end

    if (word == NULL) {
        word = new_word(sizeof(word_s))
    }

    word_s[word].value = new_word(sizeof(word_s) * (expected_args + 1))

    word_s[word].type = type
    word_s[word_s[word].value + (expected_args * sizeof(word_s))].type = WORD_NONE

    : argc = 0
    if (word_s[preloaded_word].type != WORD_NONE) {
        memmov(word_s[word].value, preloaded_word, sizeof(word_s))
        argc++
    }

    while (argc < expected_args) {
        while (length > 0 && ([str] == ' ')) {
            str++
            length--
        }

        if (length == 0) {
            if (expected_args >= VAARG) {
                // variable number of arguments
                word_s[word_s[word].value + (argc * sizeof(word_s))].type = WORD_NONE
                return word
            }
            say_error("'%s' expects %d arguments, got %d\n", get_word_name(type), expected_args, argc)
            return NULL
        }

        : have_parentheses = 0
        if ([str] == '(') {
            have_parentheses = 1
            str++
            length--
            end = find_matching_parenthesis(str, length)
            if (end == 0) {
                say_error("unclosed parentheses\n")
                return NULL
            }
            if (end == 1) {
                say_error("empty parentheses\n")
                return NULL
            }
        } else {
            end = tok_end(str, length)
        }

        : [arg]
        if (have_parentheses) {
            arg = parse_str(str, end - 1, word_s[word].value + (argc * sizeof(word_s)))
        } else {
            arg = parse_str(str, length, word_s[word].value + (argc * sizeof(word_s)))
            if (arg && word_s[arg].type >= WORD_FIRST_INST) {
                if (expected_args != argc + 1 && expected_args < VAARG) {
                    say_error("'%s' expects %d arguments, got %d\n", get_word_name(type), expected_args, argc + 1)
                    return NULL
                }
                end = length
            }
        }

        if (!arg) {
            return NULL
        }

        str = str + end
        length = length - end

        argc++
    }

    while (length > 0 && ([str] == ' ')) {
        str++
        length--
    }

    if (length == 0) {
        return word
    }

    say_error("'%s' expects %d arguments, remaining %d characters\n", get_word_name(type), expected_args, length)
    return NULL
}

#define is_str_arg(arg) (word_s[arg].type == WORD_STR || word_s[arg].type == WORD_FSTR)

func check_types([word]) {
    : args = alloca(sizeof(word_s) * (VAARG + 1))
    : argc = 0
    : var i = 0

    if (word_s[word].type < WORD_FIRST_INST) {
        return word_s[word].type
    }

    while (word_s[word_s[word].value + i].type != WORD_NONE) {
        if (argc >= VAARG) {
            say_error("should not happen, too many arguments\n")
            return EXEC_ERROR
        }
        if (word_s[word_s[word].value + i].type == WORD_VAR) {
            if ((word_s[word].type == WORD_INST_LET && argc == 0)) {
                word_s[args + i].type  = word_s[word_s[word].value + i].type
                word_s[args + i].value = word_s[word_s[word].value + i].value
            } else {
                var = word_s[word_s[word].value + i].value
                if (var_s[var].type == VAR_NONE) {
                    say_error("variable '%s' is not initialized\n", var_s[var].name)
                    return EXEC_ERROR
                }
                word_s[args + i].type  = var_s[var].type
                word_s[args + i].value = var_s[var].value
            }
        } elif (word_s[word_s[word].value + i].type < WORD_FIRST_INST) {
            word_s[args + i].type  = word_s[word_s[word].value + i].type
            word_s[args + i].value = word_s[word_s[word].value + i].value
        } else {
            : tmp = check_types(word_s[word].value + i)
            if (tmp == EXEC_ERROR) {
                return EXEC_ERROR
            }
        }
        i = i + sizeof(word_s)
        argc++
    }

    : inst = NULL
    for i (0, INSTRCTIONS_COUNT * sizeof(inst_s), sizeof(inst_s)) {
        if (inst_s[g_instructions + i].type == word_s[word].type) {
            inst = g_instructions + i
            break
        }
    }

    if (inst == NULL) {
        say_error("(internal) instruction not found\n")
        return EXEC_ERROR
    }

    if (inst_s[inst].argc < VAARG && argc != inst_s[inst].argc) {
        say_error("(internal) wrong number of arguments\n")
        return EXEC_ERROR
    }

    if (inst_s[inst].arg_types == FMT_NOTP) {
        // printf("'%s' has no type checking, returning %s\n", get_word_name(word_s[word].type), get_word_name(inst_s[inst].ret_type))
        return inst_s[inst].ret_type
    }

    if (argc > 4) {
        say_error("too many arguments for type checking\n")
        return EXEC_ERROR
    }

    for i (0, argc) {
        : expected = (inst_s[inst].arg_types >> (12 - i * 4)) &b 0xF
        if (expected == WORD_ALL) {
            // printf("skipping argument %d of '%s', any type is allowed\n", i + 1, get_word_name(word_s[word].type))
            continue
        }
        : current = word_s[args + (i * sizeof(word_s))].type
        if (is_str_arg(current) && is_str_arg(expected)) {
            // printf("skipping argument %d of '%s', string types are compatible\n", i + 1, get_word_name(word_s[word].type))
            continue
        }
        // printf("checking argument %d of '%s': expected %s, got %s\n", i + 1, get_word_name(word_s[word].type), get_word_name(expected), get_word_name(current))
        if (current != expected) {
            say_error("argument %d of '%s' has wrong type, expected %s, got %s\n", i + 1, get_word_name(word_s[word].type), get_word_name(expected), get_word_name(current))
            return EXEC_ERROR
        }
    }

    if (word_s[word].type == WORD_INST_LET) {
        var = word_s[word_s[word].value].value
        if (var_s[var].type == VAR_NONE) {
            var_s[var].type = word_s[args].type
        } elif (var_s[var].type != word_s[args].type) {
            say_error("variable '%s' has type %s, cannot assign %s\n", var_s[var].name, get_word_name(var_s[var].type), get_word_name(word_s[args].type))
            return EXEC_ERROR
        }
    }

    return inst_s[inst].ret_type
}

func program_run() // prototype


func execute_word([word], [return_value]) {
    word_s[return_value].type = WORD_NONE

    : args = alloca(sizeof(word_s) * (VAARG + 1))
    : argc = 0
    : a i = 0
    : retcode = EXEC_CONTINUE

    $ lastrand = 0x1234

    if (word_s[word].type >= WORD_FIRST_INST) {
        while (word_s[word_s[word].value + i].type != WORD_NONE) {
            if (argc >= VAARG) {
                say_error("should not happen, too many arguments\n")
                return EXEC_ERROR
            }
            if (word_s[word_s[word].value + i].type == WORD_VAR) {
                if (word_s[word].type == WORD_INST_LET || word_s[word].type == WORD_INST_INC || word_s[word].type == WORD_INST_DEC) {
                    word_s[args + i].type  = word_s[word_s[word].value + i].type
                    word_s[args + i].value = word_s[word_s[word].value + i].value
                } else {
                    word_s[args + i].type  = var_s[word_s[word_s[word].value + i].value].type
                    word_s[args + i].value = var_s[word_s[word_s[word].value + i].value].value
                }
            } elif (word_s[word_s[word].value + i].type < WORD_FIRST_INST) {
                word_s[args + i].type  = word_s[word_s[word].value + i].type
                word_s[args + i].value = word_s[word_s[word].value + i].value
            } elif (word_s[word].type != WORD_INST_IF || argc != 1) {
                a = execute_word(word_s[word].value + i, args + i)
                if (a != EXEC_CONTINUE) {
                    return a
                }
            }
            i = i + sizeof(word_s)
            argc++
        }
    }

    switch (word_s[word].type) {
        case WORD_VAR {
            word_s[return_value].type  = var_s[word_s[word].value].type
            word_s[return_value].value = var_s[word_s[word].value].value
        }

        case WORD_STR, WORD_FSTR, WORD_NUM {
            word_s[return_value].type  = word_s[word].type
            word_s[return_value].value = word_s[word].value
        }

        case WORD_INST_PRINT, WORD_INST_WRITE {
            for i (0, argc * sizeof(word_s), sizeof(word_s)) {
                switch (word_s[args + i].type) {
                    case WORD_STR {
                        print(word_s[args + i].value)
                    }
                    case WORD_FSTR {
                        print(word_s[args + i].value)
                    }
                    case WORD_NUM {
                        putnbr(word_s[args + i].value)
                    }
                    case WORD_NONE {
                        print("None")
                    }
                    default {
                        printf("[type: %d]", word_s[args + i].type)
                    }
                }
                if (i / sizeof(word_s) < argc - 1) {
                    putchar(' ')
                }
            }
            if (word_s[word].type == WORD_INST_PRINT) {
                putchar('\n')
            }
            screen_flush()
        }

        case WORD_INST_LEN {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = strlen(word_s[args].value)
        }

        case WORD_INST_STOP {
            retcode = EXEC_END
        }

        case WORD_INST_LET {
            if (var_s[word_s[args].value].type == VAR_STR) {
                free(var_s[word_s[args].value].value)
            }
            switch (word_s[args + sizeof(word_s)].type) {
                case WORD_STR {
                    var_s[word_s[args].value].type  = VAR_STR
                    var_s[word_s[args].value].value = strdup(word_s[args + sizeof(word_s)].value)
                }
                case WORD_FSTR {
                    var_s[word_s[args].value].type  = VAR_STR
                    var_s[word_s[args].value].value = word_s[args + sizeof(word_s)].value
                    return EXEC_CONTINUE // skip freeing the string, it's now owned by the variable
                }
                case WORD_NUM {
                    var_s[word_s[args].value].type  = VAR_NUM
                    var_s[word_s[args].value].value = word_s[args + sizeof(word_s)].value
                }
                default {
                    say_error("'LET' expects a string or number as second argument\n")
                    var_s[word_s[args].value].type  = VAR_NUM
                    var_s[word_s[args].value].value = 0
                    retcode = EXEC_ERROR
                }
            }
        }

        case WORD_INST_THEN {
            // arguments are already executed, nothing to do here
        }

        case WORD_INST_IF {
            if ((word_s[args].type == WORD_NUM && word_s[args].value) || (word_s[args].type == WORD_STR && [word_s[args].value])) {
                retcode = execute_word(word_s[word].value + sizeof(word_s), NULL)
            }
        }

        case WORD_INST_GOTO {
            if (word_s[args].value < 0 || word_s[args].value >= 100 || [GOTO_TABLE + word_s[args].value] == 0xFFFF) {
                say_error("label '%d' is not defined\n", word_s[args].value)
                retcode = EXEC_ERROR
            } else {
                retcode = [GOTO_TABLE + word_s[args].value]
            }
        }

        case WORD_INST_ADD {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value + word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_EQ {
            if (is_str_arg(args) || is_str_arg(args + sizeof(word_s))) {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = strcmp(word_s[args].value, word_s[args + sizeof(word_s)].value) == 0
            } elif (word_s[args].type != word_s[args + sizeof(word_s)].type) {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = 0
            } else {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = word_s[args].value == word_s[args + sizeof(word_s)].value
            }
        }

        case WORD_INST_MOD {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value % word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_INC {
            if (word_s[args].type == WORD_VAR) {
                var_s[word_s[args].value].value = var_s[word_s[args].value].value + 1
            }
        }

        case WORD_INST_DEC {
            if (word_s[args].type == WORD_VAR) {
                var_s[word_s[args].value].value = var_s[word_s[args].value].value - 1
            }
        }

        case WORD_INST_MUL {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value * word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_DIV {
            if (word_s[args + sizeof(word_s)].value == 0) {
                say_error("division by zero\n")
                retcode = EXEC_ERROR
            } else {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = word_s[args].value / word_s[args + sizeof(word_s)].value
            }
        }

        case WORD_INST_SUB {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value - word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_AND {
            word_s[return_value].type = WORD_NUM
            : b
            if (word_s[args].type == WORD_NUM) {
                a = word_s[args].value
            } elif (is_str_arg(args)) {
                a = [word_s[args].value] != 0
            } else {
                say_error("'AND' expects number or string arguments\n")
                retcode = EXEC_ERROR
                break
            }
            if (word_s[args + sizeof(word_s)].type == WORD_NUM) {
                b = word_s[args + sizeof(word_s)].value
            } elif (is_str_arg(args + sizeof(word_s))) {
                b = [word_s[args + sizeof(word_s)].value] != 0
            } else {
                say_error("'AND' expects number or string arguments\n")
                retcode = EXEC_ERROR
                break
            }
            word_s[return_value].value = a && b
        }

        case WORD_INST_OR {
            word_s[return_value].type = WORD_NUM
            if (word_s[args].type == WORD_NUM) {
                a = word_s[args].value
            } elif (is_str_arg(args)) {
                a = [word_s[args].value] != 0
            } else {
                say_error("'OR' expects number or string arguments\n")
                retcode = EXEC_ERROR
                break
            }
            if (word_s[args + sizeof(word_s)].type == WORD_NUM) {
                b = word_s[args + sizeof(word_s)].value
            } elif (is_str_arg(args + sizeof(word_s))) {
                b = [word_s[args + sizeof(word_s)].value] != 0
            } else {
                say_error("'OR' expects number or string arguments\n")
                retcode = EXEC_ERROR
                break
            }
            word_s[return_value].value = a || b
        }

        case WORD_INST_NEQ {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value != word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_GT {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value > word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_LT {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value < word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_BSHL {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = word_s[args].value << word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_BSHR {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = word_s[args].value >> word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_BAND {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = word_s[args].value &b word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_BOR {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = word_s[args].value |b word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_BXOR {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = word_s[args].value ^b word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_ELSE {
            say_error("ni\n")
            retcode = EXEC_ERROR
        }

        case WORD_INST_WHILE {
            say_error("ni\n")
            retcode = EXEC_ERROR
        }

        case WORD_INST_IN {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = in(word_s[args].value)
        }

        case WORD_INST_OUT {
            out(word_s[args].value, word_s[args + sizeof(word_s)].value)
        }

        case WORD_INST_RAND {
            lastrand = (lastrand >> 1) |b ((
                ((lastrand >> 0) ^b
                 (lastrand >> 2) ^b
                 (lastrand >> 3) ^b
                 (lastrand >> 5)) &b 1) << 15)

            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = lastrand
        }

        case WORD_INST_SRAND {
            lastrand = word_s[args].value
            if (lastrand == 0) {
                lastrand = 0x1234
            }
        }

        case WORD_INST_STR {
            say_error("ni\n")
            retcode = EXEC_ERROR
        }

        case WORD_INST_INT {
            if (!isnumber(word_s[args].value, strlen(word_s[args].value))) {
                say_error("'INT' expects a string containing only digits\n")
                retcode = EXEC_ERROR
                break
            }

            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = atoi(word_s[args].value)
        }

        case WORD_INST_INPUT {
            print(word_s[args].value)
            screen_flush()

            : [input_str] = malloc(64)
            input(input_str, 64)

            word_s[return_value].type  = WORD_FSTR
            word_s[return_value].value = input_str
        }

        case WORD_INST_CLEAR {
            screen_clear()
            screen_flush()
        }

        case WORD_INST_RMEM {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = [word_s[args].value]
        }

        case WORD_INST_WMEM {
            [word_s[args].value] = word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_ED {
            program_edit()
        }

        case WORD_INST_RUN {
            program_run()
        }

        case WORD_INST_NEW {
            memset(GOTO_TABLE, 0xFFFF, 100)
            : var = g_var_tail
            while (var) {
                if (var_s[var].type == VAR_STR) {
                    free(var_s[var].value)
                }
                var = var_s[var].prev
            }
            new_var(INTMAX)
            g_var_tail = NULL
        }

        case WORD_INST_HELP {
            printf("$02GENERAL OPERATION -$07\n")
            print("  The current interface is an interactive shell,\n")
            print("  you can write code and execute it by pressing Enter twice.\n")
            printf("  Use $0FED$07 to write longer programs, then exit by pressing Esc.\n")
            printf("  You can then execute the program using $0FRUN$07.\n")
            printf("  Defined variables remain accessible; to clear them, use $0FNEW$07.\n")
            printf("$02BASILISC LANGUAGE -$07\n")
            printf("  $07Variable assignment     $0Fname = 123\n")
            printf("  $07Instruction call        $0FinstA argA1 (instB (instC argC1) argB2) argA3\n")
            printf("  $07Create a label          $0F[0]\n")
            printf("  $07Jump to label           $0FGOTO 0\n")
            printf("  $07Conditional structure   $0FIF (something) (do_something)\n")
            printf("$02AVAILABLE INSTRUCTIONS -$0F\n")
            for i (0, INSTRCTIONS_COUNT * sizeof(inst_s), sizeof(inst_s)) {
                printf("  %s", inst_s[g_instructions + i].name)
                screen_x = screen_x + (10 - screen_x % 10)
                if (screen_x > 60) {
                    putchar('\n')
                }
            }
            printf("\n$07More information at: github.com/elydre/ancolie$0F\n")
            screen_color = 0x0F00
        }

        case WORD_INST_SSTAT {
            : varcount = 0
            var = g_var_tail
            while (var) {
                varcount++
                var = var_s[var].prev
            }

            : heap_addr = new_word(0)
            : proglen = strlen(STRPROG_DEBUT)

            printf("$02SYSTEM STATUS -$07\n")
            printf("  $07Variable table  $0F%d%%$07 (%d defined)\n", (new_var(0) - VARTAB_DEBUT) / (0x1000 / 100), varcount)
            printf("  $07Heap usage      $0F%d%%$07 (%d words used)\n", (heap_addr - HEAP_DEBUT) / ([_lSP] / 100), heap_addr - HEAP_DEBUT)
            printf("  $07Program memory  $0F%d%%$07 (%d words used)\n", proglen / (0x2000 / 100), proglen)
            printf("  $07Allocations     $0F%d\n", malloc_data.malloc_count)
            printf("  $07Current heap    $0F%x\n", heap_addr)
            printf("  $07Stack pointer   $0F%x\n", [_lSP])
        }

        case WORD_INST_DEBUG {
            g_debug = word_s[args].value
        }

        default {
            say_error("instruction '%s' (%d) is not implemented\n", get_word_name(word_s[word].type), word_s[word].type)
            retcode = EXEC_ERROR
        }
    }

    for i (0, argc * sizeof(word_s), sizeof(word_s)) {
        if (word_s[args + i].type == WORD_FSTR) {
            free(word_s[args + i].value)
        }
    }

    return retcode
}

func program_run() {
    :i

    // count how many lines are in the program
    : [program] = STRPROG_DEBUT
    : line_count = 0

    for i (0) {
        if ([program + i] == 0) {
            break
        }
        if ([program + i] == '\n') {
            line_count++
        }
    }

    // split program into lines
    : [lines] = alloca(sizeof(word_s) * (line_count + 1))
    line_count = 0

    while ([program]) {
        : end = line_end(program, strlen(program))

        if (end == 0) {
            break
        }

        program = program + check_goto_label(program, &end, line_count)
        if (end == 0) {
            program = program + 1
            continue
        }

        [lines + line_count] = parse_str(program, end, NULL)

        if ([lines + line_count] == NULL) {
            return 1
        }

        line_count++
        program = program + end + 1
    }

    for i (0, line_count) {
        if (g_debug) {
            print_word([lines + i])
            printf("\n")
        }
        if (check_types([lines + i]) == EXEC_ERROR) {
            return
        }
    }

    i = 0
    : [res] = alloca(sizeof(word_s))
    while (i < line_count) {
        : a = execute_word([lines + i], res)
        if (word_s[res].type == WORD_FSTR) {
            free(word_s[res].value)
        }

        if (a == EXEC_ERROR) {
            printf("on ", i + 1)
            print_word([lines + i])
            printf("\n")
        } elif (a == EXEC_END) {
            break
        } elif (a != EXEC_CONTINUE) {
            i = a
        } else {
            i++
        }
    }
}

func shell_iter() {
    :i

    new_word(INTMAX)
    memset(GOTO_TABLE, 0xFFFF, 100)

    : [strline] = alloca(64)
    : [lines] = alloca(sizeof(word_s) * 32)
    : line_count = 0

    print("# ")

    while (1) {
        screen_flush()

        : end = input(strline, 64)

        while ([strline] == ' ') {
            strline++
            end--
        }

        if (end == 0) {
            screen_y--
            screen_x = 1
            putchar('\b')
            break
        }

        strline = strline + check_goto_label(strline, &end, line_count)
        if (end == 0) {
            print("> ")
            continue
        }

        [lines + line_count] = parse_str(strline, end, NULL)

        if ([lines + line_count]) {
            line_count++
        } elif line_count == 0 {
            print("# ")
            continue
        }
        print("> ")
    }

    for i (0, line_count) {
        if (g_debug) {
            print_word([lines + i])
            printf("\n")
        }
        if (check_types([lines + i]) == EXEC_ERROR) {
            return
        }
    }

    i = 0
    : [res] = alloca(sizeof(word_s))
    while (i < line_count) {
        : a = execute_word([lines + i], res)

        if (word_s[res].type != WORD_NONE) {
            screen_color = 0x0700
            print("=> ")
            print_word(res)
            screen_color = 0x0F00
            if (word_s[res].type == WORD_FSTR) {
                free(word_s[res].value)
            }
            print("\n")
        }

        if (a == EXEC_ERROR) {
            print("on ")
            print_word([lines + i])
            print("\n")
            break
        } elif (a == EXEC_END) {
            break
        } elif (a != EXEC_CONTINUE) {
            i = a
        } else {
            i++
        }
    }
}

print("\n")
printf("$0F        ___   \\\\\\      $02BASILISC %s\n", BASILISC_VERSION)
printf("$0F        ). \\  ((°<     2026 elydre\n")
printf("$0F   ______):.`-//~     \n")
printf("$0F     ---==_ __.'       $07Type $0Fhelp$07 for the user guide\n" )
printf("$0F           TT          $07and press Enter twice.$0F\n\n" )

malloc_init(MALLOC_DEBUT, MALLOC_SIZE, 16)
[STRPROG_DEBUT] = 0

while (1) {
    shell_iter()
}
