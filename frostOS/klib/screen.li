func screen_flush() {
    out(0x1021, screen_y 80 * screen_x +)
    out(0x1020, 0)
}

func screen_clear() {
    memset(screen, ' ', 80 25 *)
    screen_x = 0
    screen_y = 0
}

func putchar(c) {
    if c '\n' == {
        screen_x = 0
        screen_y++
        return
    }
    if c '\r' == {
        screen_x = 0
        return
    }
    if c '\b' == {
        if screen_x 0 > {
            screen_x--
        }
        [screen 80 screen_y * + screen_x +] = ' '
        return
    }
    if screen_x 79 > {
        screen_x = 0
        screen_y++
    }
    if screen_y 24 > {
        memmov(screen, screen 80 +, 80 24 *)
        memset(screen 80 24 * +, ' ', 80)
        screen_y = 24
    }
    [screen 80 screen_y * + screen_x +] = c screen_color |
    screen_x++
}

func putnbr(n) {
    if n 9 > {
        putnbr(n 10 /)
    }

    putchar(n 10 % '0' +)
}

func puthex(n) {
    : base

    base = "0123456789ABCDEF"

    if n 15 > {
        puthex(n 16 /)
    }

    putchar([base n 16 % +])
}

func print(str) {
    : i c

    for i (0) {
        c = [str i +]
        if c 0 == {
            break
        }
        putchar(c)
    }

    screen_flush()
}

func screen_mk_color(str) {
    : i c color

    color = 0

    for i (0, 2) {
        c = [str i +]
        if c '0' >= c '9' <= && {
            color = color 16 * c '0' - +
        } elif c 'A' >= c 'F' <= && {
            color = color 16 * c 55 - +
        } elif c 'a' >= c 'f' <= && {
            color = color 16 * c 87 - +
        } else {
            return 1
        }
    }

    return color 8 <<
}

vafunc printf(argc, argp) {
    : i c str

    str = [argp]

    for i (0) {
        c = [str i +]
        if c 0 == {
            break
        }
        if c '%' == {
            i++
            c = [str i +]
            if c '%' == {
                putchar('%')
                continue
            }
            argp++
            argc--
            if argc 0 == {
                print("\n[printf not enough arguments]\n")
                return
            }
            if c 'd' == {
                putnbr([argp])
            }
            elif c 'x' == {
                putchar('0')
                putchar('x')
                puthex([argp])
            }
            elif c 's' == {
                print([argp])
            }
            elif c 'c' == {
                putchar([argp])
            }
            continue
        }
        if c '$' == {
            i++
            if [str i +] '$' == {
                putchar('$')
                continue
            }
            c = screen_mk_color(str i +)
            if c 1 == {
                print("\n[printf invalid color]\n")
                return
            }
            screen_color = c
            i++
            continue
        }
        putchar(c)
    }
}
