func free_variable_list([var]) {
    while (var) {
        : prev = var_s[var].prev
        if (var_s[var].type == VAR_STRING) {
            free(var_s[var].value)
        }
        free(var_s[var].name)
        free(var)
        var = prev
    }
}

func main() {
    :i

    // char *program =
    //         "age = 100\n"
    //         "IF (< age 18) GOTO 1\n"
    //         "PRINT \"You are an adult.\"\n"
    //         "STOP\n"
    //         "[1] PRINT \"You are a minor.\"\n"*/

    : program = "i = 123\n[1] i = + i 1\nPRINT i\nIF (< i 10) GOTO 1\n"

    // char *program =
    //        "coucou = \"hi!\"\n"
    //        "PRINT \"Hello\" (LEN \"oui\") coucou\n"
    //        "PRINT 1 LEN \"hi\"\n"
    //        "IF 1 THEN (PRINT \"if is true\") (PRINT 123)\n"*/

    // split program into lines
    : [lines] = alloca(sizeof(word_s) * 10)
    : line_count = 0

    // printf("dd%d\n", [program])

    while ([program]) {
        : end = line_end(program, strlen(program))

        if (end == 0) {
            break
        }

        printf("Line: %S\n", program, end)

        program = program + check_goto_label(program, &end, line_count)
        [lines + line_count] = parse_str(program, end, NULL)

        if ([lines + line_count] == NULL) {
            printf("Error parsing instruction: %S\n", program, end)
            return 1
        }

        line_count++
        program = program + end + 1
    }

    printf("\n") 
    for i (0, line_count) {
        print_word([lines + i])
        printf("\n")
    }

    // printf("Executing program...\n")

