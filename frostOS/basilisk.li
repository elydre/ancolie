#define VAR_STRING 1
#define VAR_NUMBER 2

#define WORD_NONE 0
#define WORD_VAR  1
#define WORD_STR  2
#define WORD_NUM  3

#define WORD_FIRST_INST 4

#define WORD_INST_INPUT 4
#define WORD_INST_PRINT 5
#define WORD_INST_GOTO  6
#define WORD_INST_IF    7
#define WORD_INST_STOP  8
#define WORD_INST_LET   9
#define WORD_INST_LEN   10
#define WORD_INST_THEN  11
#define WORD_INST_LT    12
#define WORD_INST_PLUS  13

#define VAARG_FUNC 10

#define EXEC_END      0xFFFF
#define EXEC_ERROR    0xFFFE
#define EXEC_CONTINUE 0xFFFD

// standard library
$ screen_x
$ screen_y
$ screen_color = 0x0F00

#include "malloc.li"
#include "klib/screen.li"

func issamestr([str1], str1len, [str2]) { // str2 is null-terminated
    : i

    for i (0, str1len) {
        if ([str1 + i] != [str2 + i]) {
            return 0
        }
        if ([str2 + i] == 0) {
            return 0
        }
    }

    if ([str2 + str1len] != 0) {
        return 0
    }

    return 1

}

func strlen([str]) {
    : len = 0

    while ([str + len]) {
        len++
    }

    return len
}

func strndup([str], length) {
    : [new_str] = malloc(length + 1)
    : i

    for i (0, length) {
        [new_str + i] = [str + i]
    }
    [new_str + length] = '\0'

    return new_str
}

func atoi([str]) {
    : result = 0
    : i = 0

    while ([str + i] >= '0' && [str + i] <= '9') {
        result = result * 10 + ([str + i] - '0')
        i++
    }

    return result
}

// end


struct var_s {
    : [name]
    : type
    : value  // union { [str], num }
    : [prev] // var_s
}

struct word_s {
    : type
    : value // union { word [value], var_s [var_ptr], [str], num }
}

struct inst_s {
    : type
    : [name]
    : argc
}

$ [g_var_tail] = NULL // var_s
$ [g_goto_table] = 0x10
$ [[g_instructions]]

#define INSTRCTIONS_COUNT 10

g_instructions = array(
    WORD_INST_INPUT, "INPUT", 1,
    WORD_INST_PRINT, "PRINT", VAARG_FUNC,
    WORD_INST_GOTO,  "GOTO",  1,
    WORD_INST_IF,    "IF",    2,
    WORD_INST_STOP,  "STOP",  0,
    WORD_INST_LET,   "LET",   2,
    WORD_INST_LEN,   "LEN",   1,
    WORD_INST_THEN,  "THEN",  VAARG_FUNC,
    WORD_INST_LT,    "<",     2,
    WORD_INST_PLUS,  "+",     2
)

#define HEAP_DEBUT 0x2010

func new_word(count) {
    $ addr = HEAP_DEBUT
    : old = addr

    addr = addr + sizeof(word_s) * count
    return old
}

func tok_end([str], length) {
    : in_quotes = 0
    : i = 0

    while (i < length && [str + i] && ([str + i] != ' ' || in_quotes) && [str + i] != '\n') {
        if ([str + i] == '"') {
            in_quotes = !in_quotes
        }
        i++
    }
    return i
}

func line_end([str], length) {
    : i = 0

    while (i < length && [str + i] && [str + i] != '\n') {
        i++
    }
    return i
}

func isnumber([str], length) {
    :i
    if (length == 0) {
        return 0
    }
    for i (0, length) {
        if ([str + i] < '0' || [str + i] > '9') {
            return 0
        }
    }
    return 1
}

