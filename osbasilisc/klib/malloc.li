struct mdata_s {
    : debut
    : size
    : block_size
    : index_size
    : malloc_count
}

$ g_malloc_data
g_malloc_data = alloca(sizeof(mdata_s))

#define malloc_data mdata_s[g_malloc_data]
#define MALLOC_MAGIC 0xDEAD

#define calc_index_size(size, block_size) (((size) - 1) / (16 * (block_size)) + 1)

func malloc_init(debut, size, block_size) {
    : tmp needed = 0

    tmp = calc_index_size(size, block_size)

    while (tmp != needed) {
        needed = tmp
        tmp = calc_index_size(size - tmp, block_size)
    }

    memset(debut, 0, needed)

    malloc_data.debut = debut
    malloc_data.size = size
    malloc_data.block_size = block_size
    malloc_data.index_size = needed
}

func malloc(size) {
    : debut_addr debut_index
    : addr i j k
    : free_count = 0

    : s = (size + 1) / malloc_data.block_size + 1

    for addr (malloc_data.debut, malloc_data.debut + malloc_data.index_size) {
        if ([addr] == 0xFFFF) {
            free_count = 0
            continue
        }

        for i (0, 16) {
            if ([addr] &b (1 << i) == 0) {
                if (free_count == 0) {
                    debut_addr = addr
                    debut_index = i
                }
                free_count++
            } else {
                free_count = 0
            }

            if (free_count != s) {
                continue
            }

            : d = debut_index
            for j (debut_addr, addr + 1) {
                for k (d, 16) {
                    [j] = [j] |b (1 << k)
                    if (j == addr && k == i) {
                        break
                    }
                }
                d = 0
            }
            addr = malloc_data.debut + malloc_data.index_size + debut_addr * malloc_data.block_size * 16 + debut_index * malloc_data.block_size
            [addr++] = MALLOC_MAGIC
            [addr++] = size
            malloc_data.malloc_count = malloc_data.malloc_count + 1
            dump(addr)
            return addr
        }
    }

    dump(1234)
    return 0
}

func free(addr) {
    : debut_addr
    : debut_index
    : size i j

    dump(addr)

    addr = addr - 2
    if ([addr] != MALLOC_MAGIC) {
        dump(5678)
        return
    }

    size = [addr + 1]
    size = size + 2

    addr = addr - (malloc_data.debut + malloc_data.index_size)
    debut_addr = addr / (malloc_data.block_size * 16)
    debut_index = (addr % (malloc_data.block_size * 16)) / malloc_data.block_size

    for i (debut_addr, malloc_data.index_size) {
        for j (debut_index, 16) {
            [i] = [i] &b ~(1 << j)
            size = size - malloc_data.block_size
            if (size <= 0) {
                malloc_data.malloc_count = malloc_data.malloc_count - 1
                return
            }
        }
        debut_index = 0
    }

    dump(9012)
}
