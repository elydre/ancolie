func streq(s1, s2) {
    while [s1] [s2] == {
        if [s1] 0 == [s2] 0 == && {
            return 1
        }
        s1++
        s2++
    }
    return 0
}

func strlen(str) {
    : len

    len = 0
    while [str len +] {
        len++
    }

    return len
}

func strsplit_count(buffer, delimiter) {
    : arg_count

    while [buffer] ' ' == {
        buffer++
    }

    arg_count = 0
    while [buffer] {
        while [buffer] ' ' != [buffer] && {
            buffer++
        }

        while [buffer] ' ' == {
            buffer++
        }
    
        arg_count++
    }

    return arg_count
}

func strsplit(buffer, args) {
    : arg_count tmp

    while [buffer] ' ' == {
        buffer++
    }

    arg_count = 0
    while [buffer] {
        [args arg_count +] = buffer
        arg_count++
        while [buffer] ' ' != [buffer] && {
            buffer++
        }
        while [buffer] ' ' == {
            [buffer++] = 0
        }
    }
}
