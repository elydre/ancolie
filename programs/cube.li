#define W 80
#define H 25

#define ZOOM_X 35
#define ZOOM_Y 18

// angles
$ angleX = 0
$ angleY = 0
$ angleZ = 0

// signed negation (a = -a)
#define neg(a) (~(a) + 1)

// signed less than
#define slt(a, b) (((a) ^b 0x8000) < ((b) ^b 0x8000))

// sinus and cosinus in Q8 format
$ sinus
sinus = array(
    0,     6,     13,    19,    25,    31,    38,    44,    
    50,    56,    62,    68,    74,    80,    86,    92,    
    98,    104,   109,   115,   121,   126,   132,   137,   
    142,   147,   152,   157,   162,   167,   172,   177,   
    181,   185,   190,   194,   198,   202,   206,   209,   
    213,   216,   220,   223,   226,   229,   231,   234,   
    237,   239,   241,   243,   245,   247,   248,   250,   
    251,   252,   253,   254,   255,   255,   256,   256,   
    256,   256,   256,   255,   255,   254,   253,   252,   
    251,   250,   248,   247,   245,   243,   241,   239,   
    237,   234,   231,   229,   226,   223,   220,   216,   
    213,   209,   206,   202,   198,   194,   190,   185,   
    181,   177,   172,   167,   162,   157,   152,   147,   
    142,   137,   132,   126,   121,   115,   109,   104,   
    98,    92,    86,    80,    74,    68,    62,    56,    
    50,    44,    38,    31,    25,    19,    13,    6,     
    0,     65529, 65522, 65516, 65510, 65504, 65497, 65491, 
    65485, 65479, 65473, 65467, 65461, 65455, 65449, 65443, 
    65437, 65431, 65426, 65420, 65414, 65409, 65403, 65398, 
    65393, 65388, 65383, 65378, 65373, 65368, 65363, 65358, 
    65354, 65350, 65345, 65341, 65337, 65333, 65329, 65326, 
    65322, 65319, 65315, 65312, 65309, 65306, 65304, 65301, 
    65298, 65296, 65294, 65292, 65290, 65288, 65287, 65285, 
    65284, 65283, 65282, 65281, 65280, 65280, 65279, 65279, 
    65279, 65279, 65279, 65280, 65280, 65281, 65282, 65283, 
    65284, 65285, 65287, 65288, 65290, 65292, 65294, 65296, 
    65298, 65301, 65304, 65306, 65309, 65312, 65315, 65319, 
    65322, 65326, 65329, 65333, 65337, 65341, 65345, 65350, 
    65354, 65358, 65363, 65368, 65373, 65378, 65383, 65388, 
    65393, 65398, 65403, 65409, 65414, 65420, 65426, 65431, 
    65437, 65443, 65449, 65455, 65461, 65467, 65473, 65479, 
    65485, 65491, 65497, 65504, 65510, 65516, 65522, 65529, 
)

#define sin16(a) [sinus + (a &b 255)]
#define cos16(a) [sinus + ((a + 64) &b 255)]

// signed Q8 multiplication
func q8mul(a, b) {
    : negative = ((a ^b b) &b 0x8000) != 0

    if (a &b 0x8000) {
        a = neg(a)
    }

    if (b &b 0x8000) {
        b = neg(b)
    }

    if (negative) {
        return neg((a * b) >> 8)
    }

    return (a * b) >> 8
}

// bresenham line algorithm
func line(x0, y0, x1, y1, color) {
    : dx = x1 - x0
    : dy = y1 - y0

    : sx
    if (dx &b 0x8000) {
        dx = neg(dx)
        sx = 0xFFFF
    } else {
        sx = 1
    }

    : sy
    if (dy &b 0x8000) {
        dy = neg(dy)
        sy = 0xFFFF
    } else {
        sy = 1
    }

    : err = dx - dy
    : ndy = neg(dy)

    while (1) {
        // if (x0 < W && y0 < H) {
        [_lSCREEN + y0 * W + x0] = '#' |b color
        // }

        if (x0 == x1) {
            if (y0 == y1) {
                break
            }
        }

        : e2 = err + err

        if (slt(ndy, e2)) {
            err = err - dy
            x0 = x0 + sx
        }

        if (slt(e2, dx)) {
            err = err + dx
            y0 = y0 + sy
        }
    }
}

// vertices of the cube
$ v edges py px
v = array(
    0xFF9C, 0xFF9C, 0xFF9C,
    100,    0xFF9C, 0xFF9C,
    100,    100,    0xFF9C,
    0xFF9C, 100,    0xFF9C,

    0xFF9C, 0xFF9C, 100,
    100,    0xFF9C, 100,
    100,    100,    100,
    0xFF9C, 100,    100
)

// edges of the cube
edges = array(
    0, 1,
    1, 2,
    2, 3,
    3, 0,
    4, 5,
    5, 6,
    6, 7,
    7, 4,
    0, 4,
    1, 5,
    2, 6,
    3, 7
)

px = alloca(8)
py = alloca(8)

func render() {
    : sx = sin16(angleX)
    : cx = cos16(angleX)

    : sy = sin16(angleY)
    : cy = cos16(angleY)

    : sz = sin16(angleZ)
    : cz = cos16(angleZ)

    // rotation and projection of the vertices
    : i
    for i (0, 8) {
        : x = [v + i * 3]
        : y = [v + i * 3 + 1]
        : z = [v + i * 3 + 2]

        // rotation X
        : y1 = (q8mul(cx, y)) - q8mul(sx, z)
        : z1 = (q8mul(sx, y)) + q8mul(cx, z)

        // rotation Y
        : x2 = (q8mul(cy, x)) + q8mul(sy, z1)
        : z2 = (neg(q8mul(sy, x))) + q8mul(cy, z1)

        // rotation Z
        : x3 = (q8mul(cz, x2)) - q8mul(sz, y1)
        : y3 = (q8mul(sz, x2)) + q8mul(cz, y1)

        // projection
        [px + i] = 40 + q8mul(ZOOM_X, x3)
        [py + i] = 12 + q8mul(ZOOM_Y, y3)
    }

    memset(_lSCREEN, ' ', W * H)

    for i (0, 12) {
        : a = [edges + i * 2]
        : b = [edges + i * 2 + 1]

        line([px + a], [py + a], [px + b], [py + b], (i + 1) << 8)
    }
}

// main loop
while (1) {
    render()
    out(0x1020, 0) // refresh screen
    // out(0x1031, 1) // sleep 1

    angleX = angleX + 2
    angleY = angleY + 3
    angleZ = angleZ + 1
}
