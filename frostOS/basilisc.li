func is_valid_var_name([str], length) {
    if (length == 0) {
        return 0
    }

    if (!(([str] >= 'a' && [str] <= 'z') || ([str] >= 'A' && [str] <= 'Z'))) {
        return 0
    }

    :i
    for i (1, length) {
        if (!(([str+i] >= 'a' && [str+i] <= 'z') || ([str+i] >= 'A' && [str+i] <= 'Z') || ([str+i] >= '0' && [str+i] <= '9') || [str+i] == '_')) {
            return 0
        }
    }

    return 1
}

func get_variable([str], length) {
    : [var] = g_var_tail

    while (var) {
        if (issamestr(str, length, var_s[var].name)) {
            return var
        }
        var = var_s[var].prev
    }
    return NULL
}

func get_variable_or_create([str], length) {
    : [var] = get_variable(str, length)
    if (var) {
        return var
    }

    // variable not found, create a new one
    var = new_var(length)
    var_s[var].name = var + sizeof(var_s)

    : i
    for i (0, length) {
        [var_s[var].name + i] = [str + i]
    }
    [var_s[var].name + length] = '\0'

    var_s[var].type = VAR_NUM
    var_s[var].value = 0
    var_s[var].prev = g_var_tail
    g_var_tail = var

    return var
}

func check_goto_label([str], [length], pos) {
    if ([length] == 0 || [str] != '[') {
        return 0
    }

    : i = 1
    while (i < [length] && [str+i] != ']') {
        i++
    }

    // found a label
    if (!isnumber(str + 1, i - 1)) {
        printf("Error: invalid label number: '%S'\n", str + 1, i - 1)
        return 0
    }

    : label_num = atoi(str + 1)
    if (label_num >= 100) {
        printf("Error: label number out of range: %d\n", label_num)
        return 0
    }

    [GOTO_TABLE + label_num] = pos // mark label as used
    [length] = [length] - (i + 1)

    return i + 1 // return the number of characters to skip
}

func find_matching_parenthesis([str], length) {
    : open_parens = 1
    : end = 0

    while (end < length && open_parens > 0) {
        if ([str + end] == '(') {
            open_parens++
        } elif ([str + end] == ')') {
            open_parens--
        }
        end++
    }
    if (open_parens != 0) {
        return 0
    }
    return end
}

func parse_str([str], length, [word]) { // word_s[word]
    while (length > 0 && ([str] == ' ')) {
        str++
        length--
    }

    // printf("parsing: %S\n", str, length)

    : end = tok_end(str, length)

    if (end == 0) {
        printf("Error: empty instruction\n")
        return NULL
    }

    : expected_args = 0
    : type = 0

    if (end > 1 && [str] == '"' && [str + end - 1] == '"') {
        if (word == NULL) {
            word = new_word(1)
        }
        word_s[word].type = WORD_STR
        word_s[word].value = strndup(str + 1, end - 2)
        return word
    } elif (isnumber(str, end)) {
        if (word == NULL) {
            word = new_word(1)
        }
        word_s[word].type = WORD_NUM
        word_s[word].value = atoi(str)
        return word
    }

    : [preloaded_word] = alloca(sizeof(word_s))
    word_s[preloaded_word].type = WORD_NONE

    :i
    for i (0, INSTRCTIONS_COUNT * sizeof(inst_s), sizeof(inst_s)) {
        if (issamestr(str, end, inst_s[g_instructions + i].name)) {
            type = inst_s[g_instructions + i].type
            expected_args = inst_s[g_instructions + i].argc
            break
        }
    }

    if (type == 0) {
        : debut = end
        while (debut < length && [str + debut] == ' ') {
            debut++
        }
        if (debut < length && [str + debut] == '=') {
            if (!is_valid_var_name(str, end)) {
                printf("Error: invalid variable name: '%S'\n", str, end)
                return NULL
            }
            type = WORD_INST_LET
            expected_args = 2
            word_s[preloaded_word].type = WORD_VAR
            word_s[preloaded_word].value = get_variable_or_create(str, end)
            end = debut + 1 // skip '='
        } elif (get_variable(str, end) != NULL) {
            if (word == NULL) {
                word = new_word(1)
            }
            word_s[word].type = WORD_VAR
            word_s[word].value = get_variable(str, end)
            return word
        } else {
            printf("Error: unknown instruction: '%S'\n", str, end)
            return NULL
        }
    }

    str = str + end
    length = length - end

    if (word == NULL) {
        word = new_word(1)
    }
    word_s[word].value = new_word(expected_args + 1)

    word_s[word].type = type
    word_s[word_s[word].value + expected_args].type = WORD_NONE

    : argc = 0
    if (word_s[preloaded_word].type != WORD_NONE) {
        memmov(word_s[word].value, preloaded_word, sizeof(word_s))
        argc++
    }

    while (argc < expected_args) {
        while (length > 0 && ([str] == ' ')) {
            str++
            length--
        }

        if (length == 0) {
            if (expected_args >= VAARG_FUNC) {
                // variable number of arguments
                inst_s[[word_s[word].value + (argc * sizeof(word_s))]].type = WORD_NONE
                return word
            }
            printf("Error: not enough arguments\n")
            return NULL
        }

        : have_parentheses = 0
        if ([str] == '(') {
            have_parentheses = 1
            str++
            length--
            end = find_matching_parenthesis(str, length)
            if (end == 0) {
                printf("Error: unclosed parentheses\n")
                return NULL
            }
            if (end == 1) {
                printf("Error: empty parentheses\n")
                return NULL
            }
        } else {
            end = tok_end(str, length)
        }

        : [arg]
        if (have_parentheses) {
            arg = parse_str(str, end - 1, word_s[word].value + (argc * sizeof(word_s)))
        } else {
            arg = parse_str(str, length, word_s[word].value + (argc * sizeof(word_s)))
            if (arg && word_s[arg].type >= WORD_FIRST_INST) {
                if (expected_args != argc + 1 && expected_args < VAARG_FUNC) {
                    printf("Error: wrong number of arguments %d, expected %d\n", argc + 1, expected_args)
                    return NULL
                }
                end = length
            }
        }

        if (!arg) {
            return NULL
        }

        str = str + end
        length = length - end

        argc++
    }

    while (length > 0 && ([str] == ' ')) {
        str++
        length--
    }

    if (length == 0) {
        return word
    }

    printf("Error: too many arguments\n")
    return NULL
}

func print_word([word]) { // word_s[word]
    :i

    if (word_s[word].type >= WORD_FIRST_INST) {
        printf("( ")
    }

    if (word_s[word].type == WORD_NONE) {
        printf("None ")
    } elif (word_s[word].type == WORD_VAR) {
        printf("%s ", var_s[word_s[word].value].name)
    } elif (word_s[word].type == WORD_STR) {
        printf("\"%s\" ", word_s[word].value)
    } elif (word_s[word].type == WORD_NUM) {
        printf("%d ", word_s[word].value)
    } else {
        for i (0, INTMAX, sizeof(inst_s)) {
            if (i / sizeof(inst_s) > INSTRCTIONS_COUNT) {
                printf("[type: %d] ", word_s[word].type)
                break
            }
            if (inst_s[g_instructions + i].type == word_s[word].type) {
                printf("%s ", inst_s[g_instructions + i].name)
                break
            }
        }
    }

    if (word_s[word].type < WORD_FIRST_INST) {
        return
    }

    i = 0
    while (word_s[word_s[word].value + i].type != WORD_NONE) {
        print_word(word_s[word].value + i)
        i = i + sizeof(word_s)
    }
    printf(") ")
}

func execute_word([word], [return_value]) {
    if (return_value) {
        word_s[return_value].type = WORD_NONE
    }

    : args = alloca(sizeof(word_s) * (VAARG_FUNC + 1))
    : argc = 0
    : a i = 0

    while (word_s[word_s[word].value + i].type != WORD_NONE) {
        if (argc >= VAARG_FUNC) {
            printf("Error: too many arguments\n")
            return EXEC_ERROR
        }
        if (word_s[word_s[word].value + i].type == WORD_VAR) {
            if (word_s[word].type == WORD_INST_LET) {
                word_s[args + i].type  = word_s[word_s[word].value + i].type
                word_s[args + i].value = word_s[word_s[word].value + i].value
            } else {
                word_s[args + i].type  = var_s[word_s[word_s[word].value + i].value].type
                word_s[args + i].value = var_s[word_s[word_s[word].value + i].value].value
            }
        } elif (word_s[word_s[word].value + i].type < WORD_FIRST_INST) {
            word_s[args + i].type  = word_s[word_s[word].value + i].type
            word_s[args + i].value = word_s[word_s[word].value + i].value
        } elif (word_s[word].type != WORD_INST_IF || argc != 1) {
            a = execute_word(word_s[word].value + i, args + i)
            if (a != EXEC_CONTINUE) {
                return a
            }
        }
        i = i + sizeof(word_s)
        argc++
    }

    switch (word_s[word].type) {
        case WORD_INST_PRINT, WORD_INST_WRITE {
            for i (0, argc * sizeof(word_s), sizeof(word_s)) {
                switch (word_s[args + i].type) {
                    case WORD_STR {
                        printf("%s", word_s[args + i].value)
                    }
                    case WORD_NUM {
                        printf("%d", word_s[args + i].value)
                    }
                    case WORD_NONE {
                        printf("None")
                    }
                    default {
                        printf("[type: %d]", word_s[args + i].type)
                    }
                }
                if (i / sizeof(word_s) < argc - 1) {
                    printf(" ")
                }
            }
            if (word_s[word].type == WORD_INST_PRINT) {
                printf("\n")
            }
        }

        case WORD_INST_LEN {
            if (word_s[args].type == WORD_STR) {
                if (return_value) {
                    word_s[return_value].type  = WORD_NUM
                    word_s[return_value].value = strlen(word_s[args].value)
                }
            } else {
                printf("Error: LEN expects a string argument\n")
                return EXEC_ERROR
            }
        }

        case WORD_INST_STOP {
            return EXEC_END
        }

        case WORD_INST_LET {
            if (word_s[args].type != WORD_VAR) {
                printf("Error: LET expects a variable as first argument\n")
                return EXEC_ERROR
            }
            switch (word_s[args + sizeof(word_s)].type) {
                case WORD_STR {
                    var_s[word_s[args].value].type  = VAR_STR
                    var_s[word_s[args].value].value = strdup(word_s[args + sizeof(word_s)].value)
                }
                case WORD_NUM {
                    var_s[word_s[args].value].type  = VAR_NUM
                    var_s[word_s[args].value].value = word_s[args + sizeof(word_s)].value
                }
                default {
                    printf("Error: LET expects a string or number as second argument\n")
                    return EXEC_ERROR
                }
            }
        }

        case WORD_INST_THEN {
            // arguments are already executed, nothing to do here
        }

        case WORD_INST_IF {
            if ((word_s[args].type == WORD_NUM && word_s[args].value) || (word_s[args].type == WORD_STR && [word_s[args].value])) {
                a = execute_word(word_s[word].value + sizeof(word_s), NULL)
                if (a != EXEC_CONTINUE) {
                    return a
                }
            }
        }

        case WORD_INST_GOTO {
            if (word_s[args].type != WORD_NUM) {
                printf("Error: GOTO expects a number argument\n")
                return EXEC_ERROR
            }
            if (word_s[args].value < 0 || word_s[args].value >= 100 || [GOTO_TABLE + word_s[args].value] == 0xFFFF) {
                printf("Error: GOTO label %d does not exist\n", word_s[args].value)
                return EXEC_ERROR
            }
            return [GOTO_TABLE + word_s[args].value]
        }

        case WORD_INST_LT {
            if (word_s[args].type != WORD_NUM || word_s[args + sizeof(word_s)].type != WORD_NUM) {
                printf("Error: < expects two number arguments\n")
                return EXEC_ERROR
            }
            if (return_value) {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = word_s[args].value < word_s[args + sizeof(word_s)].value
            }
        }

        case WORD_INST_PLUS {
            if (word_s[args].type != WORD_NUM || word_s[args + sizeof(word_s)].type != WORD_NUM) {
                printf("Error: + expects two number arguments\n")
                return EXEC_ERROR
            }
            if (return_value) {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = word_s[args].value + word_s[args + sizeof(word_s)].value
            }
        }

        case WORD_INST_EQ {
            if (word_s[args].type != WORD_NUM || word_s[args + sizeof(word_s)].type != WORD_NUM) {
                printf("Error: + expects two number arguments\n")
                return EXEC_ERROR
            }
            if (return_value) {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = word_s[args].value == word_s[args + sizeof(word_s)].value
            }
        }

        case WORD_INST_MOD {
            if (word_s[args].type != WORD_NUM || word_s[args + sizeof(word_s)].type != WORD_NUM) {
                printf("Error: %% expects two number arguments\n")
                return EXEC_ERROR
            }
            if (return_value) {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = word_s[args].value % word_s[args + sizeof(word_s)].value
            }
        }

        default {
            printf("Error: unknown instruction type: %d\n", word_s[word].type)
            return EXEC_ERROR
        }
    }
    return EXEC_CONTINUE
}

func free_variable_list([var]) {
    while (var) {
        : prev = var_s[var].prev
        if (var_s[var].type == VAR_STR) {
            free(var_s[var].value)
        }
        free(var_s[var].name)
        free(var)
        var = prev
    }
}

func main() {
    :i

    // : program = "i = 0\n[1] i = + i 1\nPRINT i\nIF (< i 10) GOTO 1\n"
    memset(GOTO_TABLE, 0xFFFF, 100)

    : [strline] = alloca(64)
    : [lines] = alloca(sizeof(word_s) * 32)
    : line_count = 0

    while (1) {
        print("# ")
        screen_flush()

        : end = input(strline, 64)

        if (end == 0) {
            break
        }

        strline = strline + check_goto_label(strline, &end, line_count)
        if (end == 0) {
            continue
        }

        [lines + line_count] = parse_str(strline, end, NULL)

        if ([lines + line_count]) {
            line_count++
        }
    }

    // for i (0, line_count) {
    //     print_word([lines + i])
    //     printf("\n")
    // }
    // printf("\n")

    i = 0
    while (i < line_count) {
        : a = execute_word([lines + i], NULL)

        if (a == EXEC_ERROR) {
            printf("%d: ", i + 1)
            print_word([lines + i])
            printf("\n")
            break
        } elif (a == EXEC_END) {
            break
        } elif (a != EXEC_CONTINUE) {
            i = a
        } else {
            i++
        }
    }
    // free_variable_list(g_var_tail)
}

malloc_init(MALLOC_DEBUT, MALLOC_SIZE, 16)

while (1) {
    main()
}
