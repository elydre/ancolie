#define WORD_NONE 0
#define WORD_VAR  1
#define WORD_STR  2
#define WORD_NUM  3

#define WORD_FIRST_INST 4

#define WORD_INST_INPUT 4
#define WORD_INST_PRINT 5
#define WORD_INST_WRITE 6
#define WORD_INST_GOTO  7
#define WORD_INST_IF    8
#define WORD_INST_STOP  9
#define WORD_INST_LET   10
#define WORD_INST_LEN   11
#define WORD_INST_THEN  12
#define WORD_INST_LT    13
#define WORD_INST_PLUS  14
#define WORD_INST_EQ    15
#define WORD_INST_MOD   16

#define VAARG_FUNC 10

#define EXEC_END      0xFFFF
#define EXEC_ERROR    0xFFFE
#define EXEC_CONTINUE 0xFFFD

#define VAR_STR WORD_STR
#define VAR_NUM WORD_NUM

// standard library
#include "malloc.li"
#include "klib/screen.li"
#include "klib/input.li"

func issamestr([str1], str1len, [str2]) { // str2 is null-terminated
    : i

    for i (0, str1len) {
        if ([str1 + i] != [str2 + i]) {
            return 0
        }
        if ([str2 + i] == 0) {
            return 0
        }
    }

    if ([str2 + str1len] != 0) {
        return 0
    }

    return 1

}

func strlen([str]) {
    : len = 0

    while ([str + len]) {
        len++
    }

    return len
}

func strndup([str], length) {
    : [new_str] = malloc(length + 1)
    : i

    for i (0, length) {
        [new_str + i] = [str + i]
    }
    [new_str + length] = '\0'

    return new_str
}

func strdup([str]) {
    return strndup(str, strlen(str))
}

func atoi([str]) {
    : result = 0
    : i = 0

    while ([str + i] >= '0' && [str + i] <= '9') {
        result = result * 10 + ([str + i] - '0')
        i++
    }

    return result
}

// end

struct var_s {
    : [name]
    : type
    : value  // union { [str], num }
    : [prev] // var_s
}

struct word_s {
    : type
    : value // union { word [value], var_s [var_ptr], [str], num }
}

struct inst_s {
    : type
    : [name]
    : argc
}

#define GOTO_TABLE   0x0100
#define VAR_TABLE    0x0200
#define MALLOC_DEBUT 0x2200
#define MALLOC_SIZE  0x1000
#define HEAP_DEBUT   0x3200

$ [g_var_tail] = NULL // var_s
$ [[g_instructions]]

#define INSTRCTIONS_COUNT 13

g_instructions = array(
    WORD_INST_INPUT, "INPUT", 1,
    WORD_INST_PRINT, "PRINT", VAARG_FUNC,
    WORD_INST_WRITE, "WRITE", VAARG_FUNC,
    WORD_INST_GOTO,  "GOTO",  1,
    WORD_INST_IF,    "IF",    2,
    WORD_INST_STOP,  "STOP",  0,
    WORD_INST_LET,   "LET",   2,
    WORD_INST_LEN,   "LEN",   1,
    WORD_INST_THEN,  "THEN",  VAARG_FUNC,
    WORD_INST_LT,    "<",     2,
    WORD_INST_PLUS,  "+",     2,
    WORD_INST_EQ,    "==",    2,
    WORD_INST_MOD,   "%",     2
)


func new_word(count) {
    $ addr = HEAP_DEBUT
    : old = addr

    addr = addr + sizeof(word_s) * count

    return old
}

func new_var(name_len) {
    $ addr = VAR_TABLE
    : old = addr

    addr = addr + sizeof(var_s) + name_len + 1

    if (addr > MALLOC_DEBUT) {
        printf("Error: out of memory\n")
        addr = old
        return NULL
    }
    return old
}

func tok_end([str], length) {
    : in_quotes = 0
    : i = 0

    while (i < length && [str + i] && ([str + i] != ' ' || in_quotes) && [str + i] != '\n') {
        if ([str + i] == '"') {
            in_quotes = !in_quotes
        }
        i++
    }
    return i
}

func line_end([str], length) {
    : i = 0

    while (i < length && [str + i] && [str + i] != '\n') {
        i++
    }
    return i
}

func isnumber([str], length) {
    :i
    if (length == 0) {
        return 0
    }
    for i (0, length) {
        if ([str + i] < '0' || [str + i] > '9') {
            return 0
        }
    }
    return 1
}

