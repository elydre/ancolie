#define BASILISC_VERSION "0.8"

// setings
#define BASILISC_EXIT_KEY 0x8009 // ctrl + tab

// word types
#define WORD_NONE 0
#define WORD_VAR  1
#define WORD_NUM  2
#define WORD_STR  3
#define WORD_FSTR 4
#define WORD_ANY  5 // use by type checking to allow any type

#define WORD_FIRST_INST   6
#define INSTRCTIONS_COUNT 48

#define WORD_INST_ADD   6
#define WORD_INST_SUB   7
#define WORD_INST_MUL   8
#define WORD_INST_DIV   9
#define WORD_INST_MOD   10
#define WORD_INST_LT    11
#define WORD_INST_GT    12
#define WORD_INST_EQ    13
#define WORD_INST_NEQ   14
#define WORD_INST_AND   15
#define WORD_INST_OR    16
#define WORD_INST_BSHL  17
#define WORD_INST_BSHR  18
#define WORD_INST_BAND  19
#define WORD_INST_BOR   20
#define WORD_INST_BXOR  21
#define WORD_INST_LET   22
#define WORD_INST_INC   23
#define WORD_INST_DEC   24
#define WORD_INST_INT   25
#define WORD_INST_STR   26
#define WORD_INST_LEN   27
#define WORD_INST_AT    28
#define WORD_INST_CAT   29
#define WORD_INST_GOTO  30
#define WORD_INST_IF    31
#define WORD_INST_THEN  32
#define WORD_INST_ELSE  33
#define WORD_INST_WHILE 34
#define WORD_INST_PRINT 35
#define WORD_INST_WRITE 36
#define WORD_INST_INPUT 37
#define WORD_INST_CLEAR 38
#define WORD_INST_COLOR 39
#define WORD_INST_RAND  40
#define WORD_INST_SRAND 41
#define WORD_INST_IN    42
#define WORD_INST_OUT   43
#define WORD_INST_RMEM  44
#define WORD_INST_WMEM  45
#define WORD_INST_SLEEP 46
#define WORD_INST_STOP  47
#define WORD_INST_ED    48
#define WORD_INST_RUN   49
#define WORD_INST_NEW   50
#define WORD_INST_HELP  51
#define WORD_INST_SSTAT 52
#define WORD_INST_DEBUG 53

#define VAARG           10 // max arguments in vafuncs

#define VAR_NONE        WORD_NONE
#define VAR_NUM         WORD_NUM
#define VAR_STR         WORD_STR

// execution return values
#define EXEC_END        0xFFFF
#define EXEC_ERROR      0xFFFE
#define EXEC_CONTINUE   0xFFFD

// memory layout
#define TOKCLASS_TABLE  0x0080
#define GOTO_TABLE      0x0100
#define VARTAB_DEBUT    0x0200
#define VARTAB_SIZE     0x1000
#define STRPROG_DEBUT   0x1200
#define STRPROG_SIZE    0x2000
#define MALLOC_DEBUT    0x3200
#define MALLOC_SIZE     0x1000
#define HEAP_DEBUT      0x4200

// token classes
#define TOK_OP 1
#define TOK_DB 2

// library includes
#include "klib/screen.li"
#include "klib/input.li"
#include "klib/string.li"
#include "klib/malloc.li"
#include "klib/strdup.li"
#include "editor.li"

struct var_s {
    : [name]
    : type
    : hash
    : value  // union { [str], num }
    : [prev] // var_s
}

struct word_s {
    : type
    : value // union { word [value], var_s [var_ptr], [str], num }
}

struct inst_s {
    : type
    : [name]
    : hash
    : argc
    : ret_type
    : arg_types
}

vafunc say_error(argc, [argp]) {
    : old_color = screen_color
    screen_color = 0x0900
    print("Error: ")
    _lNOVA(printf, argc, argp)
    screen_color = old_color
}

$ [g_var_tail] = NULL // var_s
$ [[g_instructions]]
$ g_debug = 0

#define FMT_ARG1(a1) (a1 << 12)
#define FMT_ARG2(a1, a2) (a1 << 12 |b a2 << 8)
#define FMT_ARG3(a1, a2, a3) (a1 << 12 |b a2 << 8 |b a3 << 4)
#define FMT_NOTP 0

g_instructions = array(
    WORD_INST_ADD,   "+",     0, 2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_SUB,   "-",     0, 2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_MUL,   "*",     0, 2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_DIV,   "/",     0, 2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_MOD,   "%",     0, 2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_LT,    "<",     0, 2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_GT,    ">",     0, 2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_EQ,    "==",    0, 2,     WORD_NUM,  FMT_ARG2(WORD_ANY, WORD_ANY),
    WORD_INST_NEQ,   "!=",    0, 2,     WORD_NUM,  FMT_ARG2(WORD_ANY, WORD_ANY),
    WORD_INST_AND,   "AND",   0, 2,     WORD_NUM,  FMT_ARG2(WORD_ANY, WORD_ANY),
    WORD_INST_OR,    "OR",    0, 2,     WORD_NUM,  FMT_ARG2(WORD_ANY, WORD_ANY),
    WORD_INST_BSHL,  "<<",    0, 2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_BSHR,  ">>",    0, 2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_BAND,  "&",     0, 2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_BOR,   "|",     0, 2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_BXOR,  "^",     0, 2,     WORD_NUM,  FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_LET,   "LET",   0, 2,     WORD_NONE, FMT_ARG2(WORD_VAR, WORD_ANY),
    WORD_INST_INC,   "INC",   0, 1,     WORD_NUM,  FMT_ARG1(WORD_NUM),
    WORD_INST_DEC,   "DEC",   0, 1,     WORD_NUM,  FMT_ARG1(WORD_NUM),
    WORD_INST_INT,   "INT",   0, 1,     WORD_NUM,  FMT_ARG1(WORD_STR),
    WORD_INST_STR,   "STR",   0, 1,     WORD_STR,  FMT_ARG1(WORD_NUM),
    WORD_INST_LEN,   "LEN",   0, 1,     WORD_NUM,  FMT_ARG1(WORD_STR),
    WORD_INST_AT,    "AT",    0, 2,     WORD_NUM,  FMT_ARG2(WORD_STR, WORD_NUM),
    WORD_INST_CAT,   "CAT",   0, VAARG, WORD_STR,  FMT_NOTP,
    WORD_INST_GOTO,  "GOTO",  0, 1,     WORD_NONE, FMT_ARG1(WORD_NUM),
    WORD_INST_IF,    "IF",    0, 2,     WORD_NONE, FMT_ARG2(WORD_NUM, WORD_ANY),
    WORD_INST_THEN,  "THEN",  0, VAARG, WORD_NONE, FMT_NOTP,
    WORD_INST_ELSE,  "ELSE",  0, VAARG, WORD_NONE, FMT_NOTP,
    WORD_INST_WHILE, "WHILE", 0, 2,     WORD_NONE, FMT_ARG2(WORD_NUM, WORD_ANY),
    WORD_INST_PRINT, "PRINT", 0, VAARG, WORD_NONE, FMT_NOTP,
    WORD_INST_WRITE, "WRITE", 0, VAARG, WORD_NONE, FMT_NOTP,
    WORD_INST_INPUT, "INPUT", 0, 1,     WORD_STR,  FMT_ARG1(WORD_STR),
    WORD_INST_CLEAR, "CLEAR", 0, 0,     WORD_NONE, FMT_NOTP,
    WORD_INST_COLOR, "COLOR", 0, 1,     WORD_NUM,  FMT_ARG1(WORD_NUM),
    WORD_INST_RAND,  "RAND",  0, 0,     WORD_NUM,  FMT_NOTP,
    WORD_INST_SRAND, "SRAND", 0, 1,     WORD_NONE, FMT_ARG1(WORD_NUM),
    WORD_INST_IN,    "IN",    0, 1,     WORD_NUM,  FMT_ARG1(WORD_NUM),
    WORD_INST_OUT,   "OUT",   0, 2,     WORD_NONE, FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_RMEM,  "RMEM",  0, 1,     WORD_NUM,  FMT_ARG1(WORD_NUM),
    WORD_INST_WMEM,  "WMEM",  0, 2,     WORD_NONE, FMT_ARG2(WORD_NUM, WORD_NUM),
    WORD_INST_SLEEP, "SLEEP", 0, 1,     WORD_NONE, FMT_ARG1(WORD_NUM),
    WORD_INST_STOP,  "STOP",  0, 0,     WORD_NONE, FMT_NOTP,
    WORD_INST_ED,    "ED",    0, 0,     WORD_NONE, FMT_NOTP,
    WORD_INST_RUN,   "RUN",   0, 0,     WORD_NONE, FMT_NOTP,
    WORD_INST_NEW,   "NEW",   0, 0,     WORD_NONE, FMT_NOTP,
    WORD_INST_HELP,  "HELP",  0, VAARG, WORD_NONE, FMT_NOTP,
    WORD_INST_SSTAT, "SSTAT", 0, 0,     WORD_NONE, FMT_NOTP,
    WORD_INST_DEBUG, "DEBUG", 0, 1,     WORD_NONE, FMT_ARG1(WORD_NUM)
)

func new_word(size) {
    $ addr = HEAP_DEBUT

    if (size == INTMAX) {
        addr = HEAP_DEBUT
        return NULL
    }

    : old = addr

    addr = addr + size

    return old
}

func new_var(size) {
    $ addr = VARTAB_DEBUT

    if (size == INTMAX) {
        addr = VARTAB_DEBUT
        return NULL
    }

    : old = addr

    addr = addr + size

    if (addr > VARTAB_DEBUT + VARTAB_SIZE) {
        say_error("out of memory\n")
        addr = old
        return NULL
    }
    return old
}

func initialize_token_class() {
    memset(TOKCLASS_TABLE, 0, 128)

    [TOKCLASS_TABLE + '('] = TOK_OP
    [TOKCLASS_TABLE + ')'] = TOK_OP
    [TOKCLASS_TABLE + '+'] = TOK_OP
    [TOKCLASS_TABLE + '-'] = TOK_OP
    [TOKCLASS_TABLE + '*'] = TOK_OP
    [TOKCLASS_TABLE + '/'] = TOK_OP
    [TOKCLASS_TABLE + '%'] = TOK_OP
    [TOKCLASS_TABLE + '<'] = TOK_OP |b TOK_DB
    [TOKCLASS_TABLE + '>'] = TOK_OP |b TOK_DB
    [TOKCLASS_TABLE + '='] = TOK_OP |b TOK_DB
    [TOKCLASS_TABLE + '!'] = TOK_OP |b TOK_DB
    [TOKCLASS_TABLE + '&'] = TOK_OP
    [TOKCLASS_TABLE + '|'] = TOK_OP
    [TOKCLASS_TABLE + '^'] = TOK_OP
}

func tok_end([str], length) {
    : in_quotes = 0
    : i = 0
    : class

    while (i < length && [str + i] && ([str + i] != ' ' || in_quotes) && [str + i] != '\n') {
        if ([str + i] == '"') {
            in_quotes = !in_quotes
        }
        if (in_quotes) {
            i++
            continue
        }

        class = [TOKCLASS_TABLE + [str + i]]

        if (class &b TOK_OP) {
            if (i) {
                return i
            }

            if (length == 1 || (class &b TOK_DB) == 0) {
                return 1
            }

            i++

            return 1 + (([TOKCLASS_TABLE + [str + i]] &b TOK_DB) != 0)
        }

        i++
    }

    return i
}

func line_end([str], length) {
    : i = 0

    while (i < length && [str + i] && [str + i] != '\n') {
        i++
    }
    return i
}

func isnumber([str], length) {
    :i
    if (length == 0) {
        return 0
    }

    if (length <= 2 || [str] != '0' || [str + 1] != 'x') {
        // decimal number
        for i (0, length) {
            if ([str + i] < '0' || [str + i] > '9') {
                return 0
            }
        }
        return 1
    }

    // hexadecimal number
    for i (2, length) {
        if (!(([str + i] >= '0' && [str + i] <= '9') ||
              ([str + i] >= 'a' && [str + i] <= 'f') ||
              ([str + i] >= 'A' && [str + i] <= 'F'))) {
            return 0
        }
    }
    return 1
}

func str2int([str], length) {
    : result = 0
    : i

    if (length <= 2 || [str] != '0' || [str + 1] != 'x') {
        // decimal number
        for i (0, length) {
            if ([str + i] >= '0' && [str + i] <= '9') {
                result = result * 10 + ([str + i] - '0')
            } else {
                break
            }
        }
        return result
    }

    // hexadecimal number
    for i (2, length) {
        if ([str + i] >= '0' && [str + i] <= '9') {
            result = result * 16 + ([str + i] - '0')
        } elif ([str + i] >= 'a' && [str + i] <= 'f') {
            result = result * 16 + ([str + i] - 'a' + 10)
        } elif ([str + i] >= 'A' && [str + i] <= 'F') {
            result = result * 16 + ([str + i] - 'A' + 10)
        } else {
            break
        }
    }

    return result
}

func int2str(num, [str]) {
    : i = 0
    : tmp = num

    if (num == 0) {
        [str] = '0'
        [str + 1] = 0
        return
    }

    while (tmp > 0) {
        tmp = tmp / 10
        i++
    }

    [str + i] = 0

    while (num > 0) {
        i--
        [str + i] = (num % 10) + '0'
        num = num / 10
    }
}

func is_valid_var_name([str], length) {
    if (length == 0) {
        return 0
    }

    if (!(([str] >= 'a' && [str] <= 'z') || ([str] >= 'A' && [str] <= 'Z'))) {
        return 0
    }

    :i
    for i (1, length) {
        if (!(([str+i] >= 'a' && [str+i] <= 'z') || ([str+i] >= 'A' && [str+i] <= 'Z') || ([str+i] >= '0' && [str+i] <= '9') || [str+i] == '_')) {
            return 0
        }
    }

    return 1
}

func hash_str([str], length) {
    : hash = 0
    : i
    : c

    for i (0, length) {
        c = [str + i]
        if (c == 0) {
            break
        }
        if (c >= 'A' && c <= 'Z') {
            c = c + ('a' - 'A')
        }
        hash = ((hash << 5) - hash) + c
    }

    return hash
}

func get_word_name(type) {
    :i
    switch (type) {
        case WORD_NONE {
            return "None"
        }
        case WORD_VAR {
            return "variable"
        }
        case WORD_NUM {
            return "number"
        }
        case WORD_STR {
            return "string"
        }
        case WORD_FSTR {
            return "fstring"
        }
        case WORD_ANY {
            return "any"
        }
    }

    if (type < INSTRCTIONS_COUNT + WORD_FIRST_INST) {
        : inst = g_instructions + (type - WORD_FIRST_INST) * sizeof(inst_s)
        return inst_s[inst].name
    }

    return "unknown"
}

func print_word(color, [word]) { // word_s[word]
    : old_color = screen_color
    screen_color = color

    if (word_s[word].type >= WORD_FIRST_INST) {
        putchar('(')
        putchar(' ')
    }

    switch (word_s[word].type) {
        case WORD_NONE {
            print("None")
        }
        case WORD_VAR {
            putchar('[')
            print(var_s[word_s[word].value].name)
            putchar(']')
        }
        case WORD_STR {
            putchar('"')
            printn(word_s[word].value + 1, [word_s[word].value])
            putchar('"')
        }
        case WORD_FSTR {
            putchar('f')
            putchar('"')
            printn(word_s[word].value + 1, [word_s[word].value])
            putchar('"')
        }
        case WORD_NUM {
            putnbr(word_s[word].value)
        }
        default {
            print(get_word_name(word_s[word].type))
        }
    }
    putchar(' ')

    if (word_s[word].type < WORD_FIRST_INST) {
        screen_color = old_color
        return
    }

    : i = 0
    while (word_s[word_s[word].value + i].type != WORD_NONE) {
        print_word(color, word_s[word].value + i)
        i = i + sizeof(word_s)
    }

    putchar(')')
    putchar(' ')

    screen_color = old_color
}

func get_instruction(hash, [str], length) {
    : i
    for i (0, INSTRCTIONS_COUNT * sizeof(inst_s), sizeof(inst_s)) {
        if (inst_s[g_instructions + i].hash != hash) {
            continue
        }
        if (strneqcase(str, length, inst_s[g_instructions + i].name)) {
            return g_instructions + i
        }
    }
    return NULL
}

func get_variable(hash, [str], length) {
    : [var] = g_var_tail

    while (var) {
        if (var_s[var].hash == hash) {
            if (strneqcase(str, length, var_s[var].name)) {
                return var
            }
        }
        var = var_s[var].prev
    }
    return NULL
}

func get_variable_or_create(hash, [str], length) {
    : [var] = get_variable(hash, str, length)
    if (var) {
        return var
    }

    // variable not found, create a new one
    var = new_var(sizeof(var_s) + length + 1)
    var_s[var].name = var + sizeof(var_s)

    : i
    for i (0, length) {
        [var_s[var].name + i] = [str + i]
    }
    [var_s[var].name + length] = '\0'

    var_s[var].type = VAR_NONE
    var_s[var].hash = hash
    var_s[var].value = 0
    var_s[var].prev = g_var_tail
    g_var_tail = var

    return var
}

func check_goto_label([str], [length], pos) {
    : l = [length]

    while (l > 0 && [str] == ' ') {
        str++
        l--
    }

    if (l == 0 || [str] != '[') {
        return 0
    }

    : i = 1
    while (i < l && [str + i] != ']') {
        i++
    }

    // found a label
    if (!isnumber(str + 1, i - 1)) {
        say_error("'%S' is not a valid label, expected a number\n", str, i + 1)
        return 0
    }

    : label_num = str2int(str + 1, i - 1)
    if (label_num >= 100) {
        say_error("label '%d' is out of range (0-99)\n", label_num)
        return 0
    }

    [GOTO_TABLE + label_num] = pos // mark label as used
    [length] = l - (i + 1)

    return i + 1 // return the number of characters to skip
}

func find_matching_parenthesis([str], length) {
    : open_parens = 1
    : end = 0

    while (end < length && open_parens > 0) {
        if ([str + end] == '(') {
            open_parens++
        } elif ([str + end] == ')') {
            open_parens--
        }
        end++
    }
    if (open_parens != 0) {
        return 0
    }
    return end
}

func is_neol([str], length) {
    : i = 0
    while (i < length && [str + i] == ' ') {
        i++
    }
    return (i != length)
}

func parse_str([str], length, [word], need_eol) { // word_s[word]
    while (length > 0 && [str] == ' ') {
        str++
        length--
    }

    // printf("parsing: %S\n", str, length)

    : end = tok_end(str, length)

    if (end == 0) {
        say_error("empty instruction\n")
        return NULL
    }

    : expected_args = 0
    : type = 0

    if (end > 1 && [str] == '"' && [str + end - 1] == '"') {
        if (word == NULL) {
            word = new_word(sizeof(word_s))
        }
        word_s[word].type = WORD_STR
        word_s[word].value = new_word(end - 1)
        str++
        memmov(word_s[word].value + 1, str, end - 2)
        [word_s[word].value] = end - 2
        if (need_eol && is_neol(str + end, length - end)) {
            say_error("unexpected characters after string\n")
            return NULL
        }
        return word
    } elif (isnumber(str, end)) {
        if (word == NULL) {
            word = new_word(sizeof(word_s))
        }
        word_s[word].type = WORD_NUM
        word_s[word].value = str2int(str, end)
        if (need_eol && is_neol(str + end, length - end)) {
            say_error("unexpected characters after number\n")
            return NULL
        }
        return word
    }

    : [preloaded_word] = alloca(sizeof(word_s))
    word_s[preloaded_word].type = WORD_NONE

    : hash = hash_str(str, end)
    : inst = get_instruction(hash, str, end)

    if (inst) {
        type = inst_s[inst].type
        expected_args = inst_s[inst].argc
    } else {
        : debut = end
        while (debut < length && [str + debut] == ' ') {
            debut++
        }
        if (debut < length && [str + debut] == '=') {
            if (!is_valid_var_name(str, end)) {
                say_error("invalid variable name: '%S'\n", str, end)
                return NULL
            }
            type = WORD_INST_LET
            expected_args = 2
            word_s[preloaded_word].type = WORD_VAR
            word_s[preloaded_word].value = get_variable_or_create(hash, str, end)
            end = debut + 1 // skip '='
        } elif (get_variable(hash, str, end) != NULL) {
            if (word == NULL) {
                word = new_word(sizeof(word_s))
            }
            word_s[word].type = WORD_VAR
            word_s[word].value = get_variable(hash, str, end)
            if (need_eol && is_neol(str + end, length - end)) {
                say_error("unexpected characters after variable\n")
                return NULL
            }
            return word
        } else {
            say_error("'%S' is not a valid instruction\n", str, end)
            return NULL
        }
    }

    str = str + end
    length = length - end

    if (word == NULL) {
        word = new_word(sizeof(word_s))
    }

    word_s[word].value = new_word(sizeof(word_s) * (expected_args + 1))

    word_s[word].type = type
    word_s[word_s[word].value + (expected_args * sizeof(word_s))].type = WORD_NONE

    : argc = 0
    if (word_s[preloaded_word].type != WORD_NONE) {
        memmov(word_s[word].value, preloaded_word, sizeof(word_s))
        argc++
    }

    while (argc < expected_args) {
        while (length > 0 && ([str] == ' ')) {
            str++
            length--
        }

        if (length == 0) {
            if (expected_args >= VAARG) {
                // variable number of arguments
                word_s[word_s[word].value + (argc * sizeof(word_s))].type = WORD_NONE
                return word
            }
            say_error("'%s' expects %d arguments, got %d\n", get_word_name(type), expected_args, argc)
            return NULL
        }

        : have_parentheses = 0
        if ([str] == '(') {
            have_parentheses = 1
            str++
            length--
            end = find_matching_parenthesis(str, length)
            if (end == 0) {
                say_error("unclosed parentheses\n")
                return NULL
            }
            if (end == 1) {
                say_error("empty parentheses\n")
                return NULL
            }
        } else {
            end = tok_end(str, length)
        }

        : [arg]
        if (have_parentheses) {
            arg = parse_str(str, end - 1, word_s[word].value + (argc * sizeof(word_s)), 1)
        } else {
            arg = parse_str(str, length, word_s[word].value + (argc * sizeof(word_s)), 0)
            if (arg && word_s[arg].type >= WORD_FIRST_INST) {
                if (expected_args != argc + 1 && expected_args < VAARG) {
                    say_error("'%s' expects %d arguments, got %d\n", get_word_name(type), expected_args, argc + 1)
                    return NULL
                }
                end = length
            }
        }

        if (!arg) {
            return NULL
        }

        str = str + end
        length = length - end

        argc++
    }

    if (is_neol(str, length)) {
        say_error("'%s' uses %d arguments but %d characters left\n", get_word_name(type), expected_args, length)
        return NULL
    }

    return word
}

#define is_str_arg(arg) (word_s[arg].type == WORD_STR || word_s[arg].type == WORD_FSTR)

func check_types([word]) {
    : args = alloca(sizeof(word_s) * (VAARG + 1))
    : argc = 0
    : var i = 0

    if (word_s[word].type < WORD_FIRST_INST) {
        return word_s[word].type
    }

    while (word_s[word_s[word].value + i].type != WORD_NONE) {
        if (argc >= VAARG) {
            say_error("should not happen, too many arguments\n")
            return EXEC_ERROR
        }
        if (word_s[word_s[word].value + i].type == WORD_VAR) {
            if ((word_s[word].type == WORD_INST_LET && argc == 0)) {
                word_s[args + i].type  = word_s[word_s[word].value + i].type
                word_s[args + i].value = word_s[word_s[word].value + i].value
            } else {
                var = word_s[word_s[word].value + i].value
                if (var_s[var].type == VAR_NONE) {
                    say_error("variable '%s' is not initialized\n", var_s[var].name)
                    return EXEC_ERROR
                }
                word_s[args + i].type  = var_s[var].type
                // word_s[args + i].value = var_s[var].value (useless)
            }
        } elif (word_s[word_s[word].value + i].type < WORD_FIRST_INST) {
            word_s[args + i].type = word_s[word_s[word].value + i].type
            // word_s[args + i].value = word_s[word_s[word].value + i].value (useless)
        } else {
            : tmp = check_types(word_s[word].value + i)
            if (tmp == EXEC_ERROR) {
                return EXEC_ERROR
            }
            word_s[args + i].type = tmp
        }
        i = i + sizeof(word_s)
        argc++
    }

    : inst = g_instructions + (word_s[word].type - WORD_FIRST_INST) * sizeof(inst_s)

    if (inst == NULL) {
        say_error("(internal) instruction not found\n")
        return EXEC_ERROR
    }

    if (inst_s[inst].argc < VAARG && argc != inst_s[inst].argc) {
        say_error("(internal) wrong number of arguments\n")
        return EXEC_ERROR
    }

    if (inst_s[inst].arg_types == FMT_NOTP) {
        // printf("'%s' has no type checking, returning %s\n", get_word_name(word_s[word].type), get_word_name(inst_s[inst].ret_type))
        return inst_s[inst].ret_type
    }

    if (argc > 4) {
        say_error("too many arguments for type checking\n")
        return EXEC_ERROR
    }

    for i (0, argc) {
        : expected = (inst_s[inst].arg_types >> (12 - i * 4)) &b 0xF
        if (expected == WORD_ANY) {
            // printf("skipping argument %d of '%s', any type is allowed\n", i + 1, get_word_name(word_s[word].type))
            continue
        }
        : current = word_s[args + (i * sizeof(word_s))].type
        if (is_str_arg(current) && is_str_arg(expected)) {
            // printf("skipping argument %d of '%s', string types are compatible\n", i + 1, get_word_name(word_s[word].type))
            continue
        }
        // printf("checking argument %d of '%s': expected %s, got %s\n", i + 1, get_word_name(word_s[word].type), get_word_name(expected), get_word_name(current))
        if (current != expected) {
            say_error("argument %d of '%s' has wrong type, expected %s, got %s\n", i + 1, get_word_name(word_s[word].type), get_word_name(expected), get_word_name(current))
            return EXEC_ERROR
        }
    }

    if (word_s[word].type == WORD_INST_LET) {
        var = word_s[word_s[word].value].value
        if (var_s[var].type == VAR_NONE) {
            var_s[var].type = word_s[args + sizeof(word_s)].type
        } elif (var_s[var].type != word_s[args + sizeof(word_s)].type) {
            say_error("variable '%s' has type %s, cannot assign %s\n", var_s[var].name, get_word_name(var_s[var].type), get_word_name(word_s[args + sizeof(word_s)].type))
            return EXEC_ERROR
        }
    }

    return inst_s[inst].ret_type
}

func program_run() // prototype

func check_interrupt() {
    : val = in(0x1010)
    while (val) {
        if (in(0x1011) == BASILISC_EXIT_KEY && val == 3) {
            printf("$07execution interrupted by user\n")
            return 1
        }
        val = in(0x1010)
    }
    return 0
}

func execute_word([word], [return_value]) {
    word_s[return_value].type = WORD_NONE

    : args = alloca(sizeof(word_s) * (VAARG + 1))
    : argc = 0
    : a i = 0
    : retcode = EXEC_CONTINUE

    $ lastrand = 0x1234
    $ lastif = 0

    if (word_s[word].type >= WORD_FIRST_INST) {
        while (word_s[word_s[word].value + i].type != WORD_NONE) {
            if (argc >= VAARG) {
                say_error("should not happen, too many arguments\n")
                return EXEC_ERROR
            }
            if (word_s[word_s[word].value + i].type == WORD_VAR) {
                if (i == 0 && word_s[word].type == WORD_INST_LET || word_s[word].type == WORD_INST_INC || word_s[word].type == WORD_INST_DEC) {
                    word_s[args + i].type  = word_s[word_s[word].value + i].type
                    word_s[args + i].value = word_s[word_s[word].value + i].value
                } else {
                    word_s[args + i].type  = var_s[word_s[word_s[word].value + i].value].type
                    word_s[args + i].value = var_s[word_s[word_s[word].value + i].value].value
                }
            } elif (word_s[word_s[word].value + i].type < WORD_FIRST_INST) {
                word_s[args + i].type  = word_s[word_s[word].value + i].type
                word_s[args + i].value = word_s[word_s[word].value + i].value
            } elif ((word_s[word].type != WORD_INST_IF || argc != 1) && word_s[word].type != WORD_INST_WHILE && (word_s[word].type != WORD_INST_ELSE || lastif != 1)) {
                a = execute_word(word_s[word].value + i, args + i)
                if (a != EXEC_CONTINUE) {
                    return a
                }
            }
            i = i + sizeof(word_s)
            argc++
        }
    }

    switch (word_s[word].type) {
        case WORD_VAR {
            word_s[return_value].type  = var_s[word_s[word].value].type
            word_s[return_value].value = var_s[word_s[word].value].value
        }

        case WORD_STR, WORD_FSTR, WORD_NUM {
            word_s[return_value].type  = word_s[word].type
            word_s[return_value].value = word_s[word].value
        }

        case WORD_INST_COLOR {
            if (word_s[args].value > 0xFF) {
                say_error("color value %d is out of range (0-255)\n", word_s[args].value)
                retcode = EXEC_ERROR
            } else {
                word_s[return_value].type  = WORD_NUM
                word_s[return_value].value = screen_color >> 8
                screen_color = word_s[args].value << 8
            }
        }

        case WORD_INST_PRINT, WORD_INST_WRITE {
            for i (0, argc * sizeof(word_s), sizeof(word_s)) {
                switch (word_s[args + i].type) {
                    case WORD_STR, WORD_FSTR {
                        printn(word_s[args + i].value + 1, [word_s[args + i].value])
                    }
                    case WORD_NUM {
                        putnbr(word_s[args + i].value)
                    }
                    case WORD_NONE {
                        print("None")
                    }
                    default {
                        printf("[type: %d]", word_s[args + i].type)
                    }
                }
                if (word_s[word].type == WORD_INST_PRINT && i / sizeof(word_s) < argc - 1) {
                    putchar(' ')
                }
            }
            if (word_s[word].type == WORD_INST_PRINT) {
                putchar('\n')
            }
            screen_flush()
        }

        case WORD_INST_LEN {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = [word_s[args].value]
        }

        case WORD_INST_AT {
            : index = word_s[args + sizeof(word_s)].value
            if (index < 0 || index >= [word_s[args].value]) {
                say_error("index %d is out of bounds for string of length %d\n", index, [word_s[args].value])
                retcode = EXEC_ERROR
            } else {
                word_s[return_value].type  = WORD_NUM
                word_s[return_value].value = [word_s[args].value + index + 1]
            }
        }

        case WORD_INST_STOP {
            retcode = EXEC_END
        }

        case WORD_INST_LET {
            if (var_s[word_s[args].value].type == VAR_STR) {
                free(var_s[word_s[args].value].value)
            }
            switch (word_s[args + sizeof(word_s)].type) {
                case WORD_STR {
                    var_s[word_s[args].value].type  = VAR_STR
                    var_s[word_s[args].value].value = malloc([word_s[args + sizeof(word_s)].value] + 1)
                    memmov(var_s[word_s[args].value].value, word_s[args + sizeof(word_s)].value, [word_s[args + sizeof(word_s)].value] + 1)
                }
                case WORD_FSTR {
                    var_s[word_s[args].value].type  = VAR_STR
                    var_s[word_s[args].value].value = word_s[args + sizeof(word_s)].value
                    return EXEC_CONTINUE // skip freeing the string, it's now owned by the variable
                }
                case WORD_NUM {
                    var_s[word_s[args].value].type  = VAR_NUM
                    var_s[word_s[args].value].value = word_s[args + sizeof(word_s)].value
                }
                default {
                    say_error("'LET' expects a string or number as second argument, got %s\n", get_word_name(word_s[args + sizeof(word_s)].type))
                    retcode = EXEC_ERROR
                }
            }
        }

        case WORD_INST_IF {
            if ((word_s[args].type == WORD_NUM && word_s[args].value) || (word_s[args].type == WORD_STR && [word_s[args].value])) {
                lastif = 1
                retcode = execute_word(word_s[word].value + sizeof(word_s), NULL)
            } else {
                lastif = 0
            }
        }

        case WORD_INST_THEN {
            // arguments are already executed, nothing to do here
        }

        case WORD_INST_ELSE {
            // arguments are already executed, nothing to do here
            lastif = !lastif
        }

        case WORD_INST_WHILE {
            : cnd = alloca(sizeof(word_s))

            while (1) {
                if (check_interrupt()) {
                    retcode = EXEC_END
                    break
                }
                retcode = execute_word(word_s[word].value, cnd)
                if (retcode != EXEC_CONTINUE) {
                    break
                }
                if ((word_s[cnd].type == WORD_NUM && word_s[cnd].value) || (word_s[cnd].type == WORD_STR && [word_s[cnd].value])) {
                    retcode = execute_word(word_s[word].value + sizeof(word_s), NULL)
                    if (retcode != EXEC_CONTINUE) {
                        break
                    }
                } else {
                    break
                }
            }
        }

        case WORD_INST_GOTO {
            if (word_s[args].value < 0 || word_s[args].value >= 100 || [GOTO_TABLE + word_s[args].value] == 0xFFFF) {
                say_error("label '%d' is not defined\n", word_s[args].value)
                retcode = EXEC_ERROR
            } else {
                if (check_interrupt()) {
                    retcode = EXEC_END
                } else {
                    retcode = [GOTO_TABLE + word_s[args].value]
                }
            }
        }

        case WORD_INST_ADD {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value + word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_EQ, WORD_INST_NEQ {
            if (word_s[args].type != word_s[args + sizeof(word_s)].type) {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = 0
            } elif (is_str_arg(args) && is_str_arg(args + sizeof(word_s))) {
                word_s[return_value].type = WORD_NUM
                : len = [word_s[args].value]
                if (len != [word_s[args + sizeof(word_s)].value]) {
                    word_s[return_value].value = 0
                } else {
                    for i (0, len) {
                        if ([word_s[args].value + i + 1] != [word_s[args + sizeof(word_s)].value + i + 1]) {
                            word_s[return_value].value = 0
                            break
                        }
                    }
                    if (i == len) {
                        word_s[return_value].value = 1
                    }
                }
            } else {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = word_s[args].value == word_s[args + sizeof(word_s)].value
            }

            if (word_s[word].type == WORD_INST_NEQ) {
                word_s[return_value].value = !word_s[return_value].value
            }
        }

        case WORD_INST_MOD {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value % word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_INC {
            if (word_s[args].type == WORD_VAR) {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = var_s[word_s[args].value].value
                var_s[word_s[args].value].value = var_s[word_s[args].value].value + 1
            }
        }

        case WORD_INST_DEC {
            if (word_s[args].type == WORD_VAR) {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = var_s[word_s[args].value].value
                var_s[word_s[args].value].value = var_s[word_s[args].value].value - 1
            }
        }

        case WORD_INST_MUL {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value * word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_DIV {
            if (word_s[args + sizeof(word_s)].value == 0) {
                say_error("division by zero\n")
                retcode = EXEC_ERROR
            } else {
                word_s[return_value].type = WORD_NUM
                word_s[return_value].value = word_s[args].value / word_s[args + sizeof(word_s)].value
            }
        }

        case WORD_INST_SUB {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value - word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_AND {
            : b
            if (word_s[args].type == WORD_NUM) {
                a = word_s[args].value
            } elif (word_s[args].type == WORD_NONE) {
                a = 0
            } elif (is_str_arg(args)) {
                a = [word_s[args].value] != 0
            } else {
                say_error("'AND' receives an unknown argument type: %s\n", get_word_name(word_s[args].type))
                retcode = EXEC_ERROR
                break
            }
            if (word_s[args + sizeof(word_s)].type == WORD_NUM) {
                b = word_s[args + sizeof(word_s)].value
            } elif (word_s[args + sizeof(word_s)].type == WORD_NONE) {
                b = 0
            } elif (is_str_arg(args + sizeof(word_s))) {
                b = [word_s[args + sizeof(word_s)].value] != 0
            } else {
                say_error("'AND' receives an unknown argument type: %s\n", get_word_name(word_s[args + sizeof(word_s)].type))
                retcode = EXEC_ERROR
                break
            }
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = a && b
        }

        case WORD_INST_OR {
            if (word_s[args].type == WORD_NUM) {
                a = word_s[args].value
            } elif (word_s[args].type == WORD_NONE) {
                a = 0
            } elif (is_str_arg(args)) {
                a = [word_s[args].value] != 0
            } else {
                say_error("'OR' receives an unknown argument type: %s\n", get_word_name(word_s[args].type))
                retcode = EXEC_ERROR
                break
            }
            if (word_s[args + sizeof(word_s)].type == WORD_NUM) {
                b = word_s[args + sizeof(word_s)].value
            } elif (word_s[args + sizeof(word_s)].type == WORD_NONE) {
                b = 0
            } elif (is_str_arg(args + sizeof(word_s))) {
                b = [word_s[args + sizeof(word_s)].value] != 0
            } else {
                say_error("'OR' receives an unknown argument type: %s\n", get_word_name(word_s[args + sizeof(word_s)].type))
                retcode = EXEC_ERROR
                break
            }
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = a || b
        }

        case WORD_INST_GT {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value > word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_LT {
            word_s[return_value].type = WORD_NUM
            word_s[return_value].value = word_s[args].value < word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_BSHL {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = word_s[args].value << word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_BSHR {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = word_s[args].value >> word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_BAND {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = word_s[args].value &b word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_BOR {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = word_s[args].value |b word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_BXOR {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = word_s[args].value ^b word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_IN {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = in(word_s[args].value)
        }

        case WORD_INST_OUT {
            out(word_s[args].value, word_s[args + sizeof(word_s)].value)
        }

        case WORD_INST_SLEEP {
            for i (0, word_s[args].value / 20) {
                dump(1234)
                out(0x1031, 20)
                if (check_interrupt()) {
                    retcode = EXEC_END
                    break
                }
            }

            a = word_s[args].value % 20
            if (a) {
                out(0x1031, a)
            }
        }

        case WORD_INST_RAND {
            lastrand = (lastrand >> 1) |b ((
                ((lastrand >> 0) ^b
                 (lastrand >> 2) ^b
                 (lastrand >> 3) ^b
                 (lastrand >> 5)) &b 1) << 15)

            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = lastrand
        }

        case WORD_INST_SRAND {
            lastrand = word_s[args].value
            if (lastrand == 0) {
                lastrand = 0x1234
            }
        }

        case WORD_INST_STR {
            word_s[return_value].type  = WORD_FSTR
            word_s[return_value].value = malloc(7) // len prefix + "65535" + 1
            if (!word_s[return_value].value) {
                say_error("out of memory\n")
                retcode = EXEC_ERROR
                break
            }
            int2str(word_s[args].value, word_s[return_value].value + 1)
            [word_s[return_value].value] = strlen(word_s[return_value].value + 1)
        }

        case WORD_INST_CAT {
            len = 0
            for i (0, argc * sizeof(word_s), sizeof(word_s)) {
                if (word_s[args + i].type == WORD_FSTR || word_s[args + i].type == WORD_STR) {
                    len = len + [word_s[args + i].value]
                } elif (word_s[args + i].type == WORD_NUM) {
                    if (word_s[args + i].value > 255) {
                        say_error("'CAT' expects an ascii character (0-255), got %d\n", word_s[args + i].value)
                        retcode = EXEC_ERROR
                        break
                    }
                    len++
                } else {
                    say_error("'CAT' receives an unknown argument type: %s\n", get_word_name(word_s[args + i].type))
                    retcode = EXEC_ERROR
                    break
                }
            }

            : str = malloc(len + 1)
            if (!str) {
                say_error("out of memory\n")
                retcode = EXEC_ERROR
                break
            }

            len = 0

            : j
            for i (0, argc * sizeof(word_s), sizeof(word_s)) {
                if (word_s[args + i].type == WORD_FSTR || word_s[args + i].type == WORD_STR) {
                    for j (1, [word_s[args + i].value] + 1) {
                        [str + len + j] = [word_s[args + i].value + j]
                    }
                    len = len + j - 1
                } elif (word_s[args + i].type == WORD_NUM) {
                    len++
                    [str + len] = word_s[args + i].value
                }
            }
            
            [str] = len

            word_s[return_value].type  = WORD_FSTR
            word_s[return_value].value = str
        }

        case WORD_INST_INT {
            len = strlen(word_s[args].value)

            word_s[return_value].type  = WORD_NUM

            if (isnumber(word_s[args].value, len)) {
                word_s[return_value].value = str2int(word_s[args].value, len)
            } else {
                word_s[return_value].value = 0xFFFF
            }
        }

        case WORD_INST_INPUT {
            printn(word_s[args].value + 1, [word_s[args].value])
            screen_flush()

            : [input_str] = malloc(64)
            if (!input_str) {
                say_error("out of memory\n")
                retcode = EXEC_ERROR
                break
            }

            if (input(input_str, 64) == INTMAX) {
                printf("\n$07execution interrupted by user\n")
                free(input_str)
                retcode = EXEC_END
                break
            }

            putchar('\n')
            screen_flush()

            word_s[return_value].type  = WORD_FSTR
            word_s[return_value].value = input_str
        }

        case WORD_INST_CLEAR {
            screen_clear()
            screen_flush()
        }

        case WORD_INST_RMEM {
            word_s[return_value].type  = WORD_NUM
            word_s[return_value].value = [word_s[args].value]
        }

        case WORD_INST_WMEM {
            [word_s[args].value] = word_s[args + sizeof(word_s)].value
        }

        case WORD_INST_ED {
            program_edit()
        }

        case WORD_INST_RUN {
            program_run()
        }

        case WORD_INST_NEW {
            memset(GOTO_TABLE, 0xFFFF, 100)
            : var = g_var_tail
            while (var) {
                if (var_s[var].type == VAR_STR) {
                    free(var_s[var].value)
                }
                var = var_s[var].prev
            }
            new_var(INTMAX)
            g_var_tail = NULL
        }

        case WORD_INST_HELP {
            : old_color = screen_color

            if (argc == 0) {
                screen_color = 0x0700
                printf("$02GENERAL OPERATION -\n")
                print("  The current interface is an interactive shell,\n")
                print("  you can write code and execute it by pressing Enter twice.\n")
                printf("  Use $0FED$07 to write longer programs, then exit by pressing CTRL+TAB.\n")
                printf("  You can then execute the program using $0FRUN$07.\n")
                printf("  Defined variables remain accessible; to clear them, use $0FNEW$07.\n")
                printf("$02BASILISC LANGUAGE -\n")
                printf("  Variable assignment     $0Fname = 123\n")
                printf("  Instruction call        $0FinstA argA1 (instB (instC argC1) argB2) argA3\n")
                printf("  Create a label          $0F[0]\n")
                printf("  Jump to label           $0FGOTO 0\n")
                printf("  Conditional structure   $0FIF (something) (do_something)\n")
                printf("  Specific information    $0FHELP \"inst\"\n")
                printf("$02AVAILABLE INSTRUCTIONS -\n")
                screen_color = 0x0F00
                for i (0, INSTRCTIONS_COUNT * sizeof(inst_s), sizeof(inst_s)) {
                    putchar(' ')
                    putchar(' ')
                    print(inst_s[g_instructions + i].name)
                    screen_x = screen_x + (10 - screen_x % 10)
                    if (screen_x > 60) {
                        putchar('\n')
                    }
                }
                printf("\n$07More information at: github.com/elydre/ancolie\n")
                screen_color = old_color
                break
            }

            screen_color = 0x0F00

            for i (0, argc * sizeof(word_s), sizeof(word_s)) {
                if (!is_str_arg(args + i)) {
                    say_error("'HELP' expects string arguments, got %s\n", get_word_name(word_s[args + i].type))
                    retcode = EXEC_ERROR
                    break
                }

                : inst = get_instruction(hash_str(word_s[args + i].value + 1, [word_s[args + i].value]),
                            word_s[args + i].value + 1, [word_s[args + i].value])

                if (inst) {
                    printf("( %s ", inst_s[inst].name)

                    if (inst_s[inst].argc == VAARG) {
                        print("... ")
                    } elif (inst_s[inst].argc > 4) {
                        print("? ")
                    } else {
                        for b (0, inst_s[inst].argc) {
                            printf("%s ", get_word_name((inst_s[inst].arg_types >> (12 - b * 4)) &b 0xF))
                        }
                    }

                    printf(") -> %s\n", get_word_name(inst_s[inst].ret_type))
                } else {
                    say_error("'%S' is not a valid instruction\n", word_s[args + i].value + 1, [word_s[args + i].value])
                    retcode = EXEC_ERROR
                    break
                }
            }

            screen_color = old_color
        }

        case WORD_INST_SSTAT {
            : varcount = 0
            var = g_var_tail
            while (var) {
                varcount++
                var = var_s[var].prev
            }

            : heap_addr = new_word(0)
            : proglen = strlen(STRPROG_DEBUT)

            printf("$02SYSTEM STATUS -\n")
            printf("$07  Variable table  $0F%d%%$07 (%d defined)\n", (new_var(0) - VARTAB_DEBUT) / (0x1000 / 100), varcount)
            printf("$07  Heap usage      $0F%d%%$07 (%d words used)\n", (heap_addr - HEAP_DEBUT) / ([_lSP] / 100), heap_addr - HEAP_DEBUT)
            printf("$07  Program memory  $0F%d%%$07 (%d words used)\n", proglen / (0x2000 / 100), proglen)
            printf("$07  Allocations     $0F%d\n", malloc_data.malloc_count)
            printf("$07  Current heap    $0F%x\n", heap_addr)
            printf("$07  Stack pointer   $0F%x\n", [_lSP])
        }

        case WORD_INST_DEBUG {
            g_debug = word_s[args].value
        }

        default {
            say_error("instruction '%s' (%d) is not implemented\n", get_word_name(word_s[word].type), word_s[word].type)
            retcode = EXEC_ERROR
        }
    }

    for i (0, argc * sizeof(word_s), sizeof(word_s)) {
        if (word_s[args + i].type == WORD_FSTR) {
            free(word_s[args + i].value)
        }
    }

    return retcode
}

func program_run() {
    : i inst

    // count how many lines are in the program
    : [program] = STRPROG_DEBUT
    : line_count = 0

    for i (0) {
        if ([program + i] == 0) {
            break
        }
        if ([program + i] == '\n') {
            line_count++
        }
    }

    // split program into lines
    : [lines] = alloca(sizeof(word_s) * (line_count + 1))
    line_count = 0

    while ([program]) {
        : end = line_end(program, 0xFFFF)

        program = program + check_goto_label(program, &end, line_count)

        if (end == 0) {
            if ([program]) {
                program++
                continue
            }
            break
        }

        inst = parse_str(program, end, NULL, 1)

        if (inst == NULL) {
            printf("$09on %S\n", program, end)
            return 1
        }

        if (g_debug) {
            print_word(0x0700, inst)
            print("\n")
        }

        if (check_types(inst) == EXEC_ERROR) {
            printf("$09on ")
            print_word(0x0900, inst)
            print("\n")
            return
        }

        [lines + line_count] = inst

        line_count++
        program = program + end + 1
    }

    printf("$07execution started !\n")

    i = 0
    : [res] = alloca(sizeof(word_s))
    while (i < line_count) {
        : a = execute_word([lines + i], res)
        if (word_s[res].type == WORD_FSTR) {
            free(word_s[res].value)
        }

        if (a == EXEC_ERROR) {
            printf("$09on ")
            print_word(0x0900, [lines + i])
            print("\n")
            break
        } elif (a == EXEC_END) {
            break
        } elif (a != EXEC_CONTINUE) {
            i = a
        } else {
            i++
        }
    }
}

func shell_iter() {
    : i inst

    new_word(INTMAX)
    memset(GOTO_TABLE, 0xFFFF, 100)

    : [str] [strline] = alloca(64)
    : [lines] = alloca(sizeof(word_s) * 32)
    : line_count = 0

    : old_color = screen_color
    screen_color = 0x0F00

    print("# ")

    while (1) {
        screen_flush()

        str = strline
        : end = input(str, 64)

        if (end == INTMAX) {
            if (line_count) {
                printf("\n$07cancelled\n")
            } else {
                screen_clear()
            }
            return
        }

        while (end && [str] == ' ') {
            str++
            end--
        }

        if (end == 0) {
            if (line_count == 0) {
                screen_x = 2
                continue
            }
            screen_x = 1
            putchar('\b')
            break
        }

        putchar('\n')

        str = str + check_goto_label(str, &end, line_count)
        if (end == 0) {
            print("> ")
            continue
        }

        inst = parse_str(str, end, NULL, 1)

        if (inst) {
            if (check_types(inst) != EXEC_ERROR) {
                [lines + line_count] = inst
                line_count++
            }
        }

        if (line_count == 0) {
            print("# ")
        } else {
            print("> ")
        }
    }

    screen_flush()

    for i (0, line_count) {
        if (g_debug) {
            print_word(0x0700, [lines + i])
            print("\n")
        }
    }

    screen_color = old_color

    i = 0
    : [res] = alloca(sizeof(word_s))
    while (i < line_count) {
        : a = execute_word([lines + i], res)

        if (word_s[[lines + i]].type != WORD_INST_INC && word_s[res].type != WORD_NONE) {
            printf("$07=> ")
            print_word(0x0700, res)
            print("\n")
            if (word_s[res].type == WORD_FSTR) {
                free(word_s[res].value)
            }
        }

        if (a == EXEC_ERROR) {
            printf("$09on ")
            print_word(0x0900, [lines + i])
            print("\n")
            break
        } elif (a == EXEC_END) {
            break
        } elif (a != EXEC_CONTINUE) {
            i = a
        } else {
            i++
        }
    }
}

func initialize() {
    putchar('\n')
    printf("        ___   \\\\\\      $02BASILISC %s\n", BASILISC_VERSION)
    printf("        ). \\  ((°<     2026 elydre\n")
    printf("   ______):.`-//~     \n")
    printf("     ---==_ __.'       $07Type $0Fhelp$07 for the user guide\n" )
    printf("           TT          $07and press Enter twice.\n\n" )

    malloc_init(MALLOC_DEBUT, MALLOC_SIZE, 16)
    initialize_token_class()
    [STRPROG_DEBUT] = 0

    :i inst
    for i (0, INSTRCTIONS_COUNT) {
        inst = g_instructions + i * sizeof(inst_s)
        if (inst_s[inst].type != i + WORD_FIRST_INST) {
            say_error("(internal) instruction '%s' has type %d, expected %d\n", inst_s[inst].name, inst_s[inst].type, i + WORD_FIRST_INST)
        }
        inst_s[inst].hash = hash_str(inst_s[inst].name, 0xFFFF)
    }
}

initialize()

