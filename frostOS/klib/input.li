func input(buffer, size) {
    :buffer_i type chr
    buffer_i = 0

    while 1 {
        type = in(0x1010)
        if type 0 == {
            // nothing for now
            out(0x1031, 1)
            continue
        }
        if type 2 == {
            // keyboard release
            in(0x1011) // consume the keycode
            continue
        }

        chr = in(0x1011)

        if chr '\b' == {
            if buffer_i 0 > {
                buffer_i--
                putchar('\b')
                screen_flush()
            }
            continue
        }

        if chr '\r' == {
            putchar('\n')
            screen_flush()
            [buffer buffer_i +] = 0
            return buffer_i
        }

        if buffer_i size 1 - < {
            [buffer buffer_i +] = chr
            putchar(chr)
            screen_flush()
            buffer_i++
        }
    }
}
